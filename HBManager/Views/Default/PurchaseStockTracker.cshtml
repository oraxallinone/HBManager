                                        <th data-column="3">Age<span class="stock-sort-icon"></span></th>
                                        <th data-column="4">Pur. Date<span class="stock-sort-icon"></span></th>
                                        <th data-column="5">Qty<span class="stock-sort-icon"></span></th>
                                        <th data-column="6">Pur. Price<span class="stock-sort-icon"></span></th>
                                        <th data-column="7">Last Price<span class="stock-sort-icon"></span></th>
