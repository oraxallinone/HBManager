@{
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    ViewBag.Title = "Import Error Logs";
    Page.Title = ViewBag.Title;
}

@section head {
    <link rel="stylesheet" href="~/Content/error-logs.css" />
}

@section scripts {
    <script src="~/Scripts/error-logs.js"></script>
}

    <div class="log-container">
        <div class="log-header">
            <div class="log-title-area">
                <h2><i class="bi bi-exclamation-triangle-fill text-danger" aria-hidden="true"></i> Import Error Logs</h2>
                <p class="subtitle">Real-time log trace captured during import operations</p>
            </div>
            <div class="log-action-buttons">
                <button id="btnTestException" type="button" class="btn btn-warning">
                    <i class="bi bi-bug" aria-hidden="true"></i> Test Exception
                </button>
                <button id="btnRefreshLogs" type="button" class="btn btn-primary">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
                </button>
                <button id="btnClearLogs" type="button" class="btn btn-danger">
                    <i class="bi bi-trash" aria-hidden="true"></i> Clear Logs
                </button>
            </div>
        </div>

        <div id="errorLogsConfig" hidden
             data-get-logs-url="@Url.Action("GetErrorLogs", "Import")"
             data-clear-logs-url="@Url.Action("ClearErrorLogs", "Import")"
             data-test-exception-url="@Url.Action("TestException", "Import")"></div>

        <div class="log-viewer-wrapper">
            <pre id="logContentArea" class="log-terminal">Loading error logs...</pre>
        </div>
    </div>
