@*|| bootstrap.min.css, ImportInitiate-inline1.css || jquery.min.js, ImportInitiate-inline2.js, bootstrap.min.js, year-month-filter.js, ImportInitiate-inline5.js ||*@
@model HBManager.Models.BudgetImportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HBManager - Budget Bulk Import</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Views/Import/ImportInitiate-inline1.css")" />
</head>
<body>
    <div class="container-fluid">
        <div class="main-card">
            
            
            <div id="summaryPanel" class="alert" style="display:none; padding: 15px; margin-bottom: 20px;">
                <h4 id="summaryStatus" style="margin-top: 0; font-weight: bold;"></h4>
                <ul style="margin-bottom: 5px;">
                    <li><strong>Records Inserted Successfully:</strong> <span id="statInserted">0</span></li>
                    <li><strong>Duplicate Records Skipped:</strong> <span id="statDuplicates">0</span></li>
                </ul>
                <p id="summaryMessage" style="margin-top: 10px; font-style: italic;"></p>
            </div>
            <div class="row">
                <div class="col-md-4">
                    @using (Html.BeginForm("ImportCsv", "Import", FormMethod.Post, new
                    {
                        id = "csvImportForm",
                        data_move_url = Url.Action("MoveData", "Import"),
                        data_revert_url = Url.Action("RevertTransfer", "Import"),
                        data_delete_url = Url.Action("DeleteBudgetInitiate", "Import"),
                        data_update_url = Url.Action("UpdateDetails", "Import"),
                        data_bank_names_url = Url.Action("GetBankNames", "Import"),
                        data_budget_data_url = Url.Action("GetBudgetData", "Import")
                    }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label class="control-label" style="font-weight:bold; margin-bottom: 8px;">Paste CSV transactions:</label>
                            <textarea id="csvData" name="csvData" class="form-control textarea-sql" rows="18"
                                      placeholder="BankName,Year,Month,TransactionType,Amount,TransactionDate,Details,IsTransfer&#10;Example Bank,2026,10,Expense,1234.50,2026-10-22,Groceries,false"></textarea>
                            <small>Include the header row. Quote fields containing commas and use YYYY-MM-DD dates.</small>
                        </div>

                        <div class="form-group" style="margin-top:15px;">
                            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-flash"></span> Import CSV</button>
                            <button type="button" id="btnClear" class="btn btn-default">Clear Everything</button>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        

                        <div style="display: flex; align-items: center; gap: 10px;">
                            <select class="form-control input-sm filter-group-inline" id="ddlYear" style="width: 100px;">
                                <option value="0">--Year--</option>
                                <option value="2024">2024</option>
                                <option value="2025">2025</option>
                                <option value="2026">2026</option>
                                <option value="2027">2027</option>
                            </select>

                            <select class="form-control input-sm filter-group-inline" id="ddlMonth" style="width: 120px;">
                                <option value="0">--Month--</option>
                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8">August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>

                            <select class="form-control input-sm filter-group-inline" id="ddlbyBank" style="width: 120px;">
                                <option value="">--Bank--</option>
                            </select>

                            <button type="button" id="btnMove" class="btn btn-sm btn-success" style="font-weight: bold; padding: 5px 20px;">
                                <span class="glyphicon glyphicon-export"></span> Move
                            </button>
                        </div>
                    </div>

                    <div class="grid-container">
                        <table class="table table-striped table-bordered table-condensed table-sticky" id="auditGrid" style="font-size: 11px; margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th>ID<input type="search" class="column-search" data-column="0" placeholder="Search"></th>
                                    <th>Bank<input type="search" class="column-search" data-column="1" placeholder="Search"></th>
                                    <th>Period<input type="search" class="column-search" data-column="2" placeholder="Search"></th>
                                    <th>Type<input type="search" class="column-search" data-column="3" placeholder="Search"></th>
                                    <th style="min-width: 120px; text-align: center;">IsTransfered?<input type="search" class="column-search" data-column="4" placeholder="Search"></th>
                                    <th>Amount<input type="search" class="column-search" data-column="5" placeholder="Search"></th>
                                    <th>Date<input type="search" class="column-search" data-column="6" placeholder="Search"></th>
                                    <th>Details<input type="search" class="column-search" data-column="7" placeholder="Search"></th>
                                    <th style="text-align:center;">Delete<input type="search" class="column-search" data-column="8" placeholder="Search"></th>
                                    <th style="text-align:center;">Revert<input type="search" class="column-search" data-column="9" placeholder="Search"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="detailsModalTitle">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="detailsModalTitle">Update Details</h4>
                </div>
                <div class="modal-body">
                    <textarea id="detailsEditor" class="form-control" rows="7"></textarea>
                    <input type="hidden" id="detailsRecordId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveDetails" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="@Url.Content("~/Scripts/ViewAssets/Views/Import/ImportInitiate-inline2.js")"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="~/Scripts/year-month-filter.js?v=20260827"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/ViewAssets/Views/Import/ImportInitiate-inline5.js")"></script>
</body>
</html>