@{
    ViewBag.Title = "Update Budget Spend Date";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/update-datetime-index.css" />



<div id="updateDatetimeConfig" hidden data-get-budget-data-url="@Url.Action("GetBudgetData", "UpdateDateTime")" data-update-budget-date-url="@Url.Action("UpdateBudgetDate", "UpdateDateTime")"></div>
<div class="app-content update-datetime-page">
    <div class="container-fluid">
        <div class="update-datetime-panel">
            <h2 class="update-datetime-title">Update Budget Spend Date</h2>

            <div class="row g-3 update-datetime-filters">
                <div class="col-md-3">
                    <label for="month-ddl">Month:</label>
                    <select id="month-ddl" class="form-control"></select>
                </div>
                <div class="col-md-3">
                    <label for="year-ddl">Year:</label>
                    <select id="year-ddl" class="form-control"></select>
                </div>
                <div class="col-md-2">
                    <button id="load-data-btn" class="btn form-control">Load Data</button>
                </div>
            </div>

            <div id="budget-table-wrapper">
                <table id="budget-table" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Spend Date</th>
                            <th>Amount</th>
                            <th>Details</th>
                            <th>Bank</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/update-datetime-index.js"></script>
