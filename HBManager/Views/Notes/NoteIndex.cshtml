@{
    ViewBag.Title = "TaskMaster";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link href='@Url.Content("~/Content/note-index.css")?v=20261111-silver-lion-strips' rel="stylesheet" />

<main class="task-page">
    <header class="task-toolbar" aria-label="Task search and controls">
        <label class="task-search">
            <i class="fa fa-search" aria-hidden="true"></i>
            <input id="taskSearch" type="search" placeholder="Search by title, description, or subtasks..." aria-label="Search tasks" />
        </label>
        <div class="task-stats" aria-live="polite">
            <span class="task-stat"><i class="stat-dot stat-dot-total"></i>Total: <strong id="totalCount">0</strong></span>
            <span class="task-stat"><i class="stat-dot stat-dot-pending"></i>Pending: <strong id="pendingCount">0</strong></span>
            <span class="task-stat"><i class="stat-dot stat-dot-completed"></i>Completed: <strong id="completedCount">0</strong></span>
        </div>
        <div class="task-filters">
            <div class="task-filter-group">
                <label for="priorityFilter">Priority</label>
                <select id="priorityFilter" class="task-select"><option value="">All Priorities</option></select>
            </div>
            <div class="task-filter-group">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" class="task-select">
                    <option value="">All Status</option>
                    <option value="pending">Pending</option>
                    <option value="completed">Completed</option>
                </select>
            </div>
        </div>
        <div class="task-toolbar-actions">
            <button type="button" id="btnNewTask" class="task-button task-button-primary"><i class="fa fa-plus" aria-hidden="true"></i> New Task</button>
        </div>
    </header>

    <section id="taskGrid" class="task-grid" aria-live="polite"></section>
    <p id="emptyTasks" class="task-empty" hidden>No tasks match your search or filters.</p>

    <div id="taskModal" class="task-modal" role="dialog" aria-modal="true" aria-labelledby="taskModalTitle" hidden>
        <div class="task-modal-backdrop" data-close-modal></div>
        <div class="task-modal-card">
            <div class="task-modal-heading">
                <h2 id="taskModalTitle">New Task</h2>
                <button type="button" class="task-modal-close" data-close-modal aria-label="Close">&times;</button>
            </div>
            <form id="taskForm">
                <input type="hidden" id="taskId" />
                <label for="taskTitle">Title</label>
                <input id="taskTitle" type="text" maxlength="255" required />
                <label for="taskDescription">Description</label>
                <textarea id="taskDescription" rows="3" placeholder="Add a few details..."></textarea>
                <div class="task-form-row">
                    <div><label for="taskDate">Due date</label><input id="taskDate" type="date" required /></div>
                    <div><label for="taskPriority">Priority (number)</label><input id="taskPriority" type="number" step="1" value="0" required /></div>
                </div>
                <div class="task-modal-actions">
                    <button type="button" class="task-button task-button-secondary" data-close-modal>Cancel</button>
                    <button type="submit" id="btnSaveTask" class="task-button task-button-primary">Create Task</button>
                </div>
            </form>
        </div>
    </div>
</main>

<script>
    window.noteTaskUrls = {
        getNotes: '@Url.Action("GetNotes", "Notes")',
        addNote: '@Url.Action("AddNote", "Notes")',
        updateNote: '@Url.Action("UpdateNote", "Notes")',
        deleteNote: '@Url.Action("DeleteNote", "Notes")',
        updateNoteCompletion: '@Url.Action("UpdateNoteCompletion", "Notes")',
        getSubNotes: '@Url.Action("GetSubNotes", "Notes")',
        addSubNote: '@Url.Action("AddSubNote", "Notes")',
        updateSubNote: '@Url.Action("UpdateSubNote", "Notes")',
        deleteSubNote: '@Url.Action("DeleteSubNote", "Notes")',
        updateSubNoteCompletion: '@Url.Action("UpdateSubNoteCompletion", "Notes")'
    };
</script>
<script src="~/Scripts/note-index.js"></script>
