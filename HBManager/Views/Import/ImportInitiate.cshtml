@model HBManager.Models.BudgetImportViewModel
@{
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    Page.Title = "HBManager - Budget Bulk Import";
}

@section head {
    <link rel="stylesheet" href="~/Content/import-initiate.css" />
}

@section scripts {
    <script src="~/Scripts/year-month-filter.js?v=20260827"></script>
    <script src="~/Scripts/import-initiate.js"></script>
}

    <div id="importInitiateConfig" hidden data-move-data-url="@Url.Action("MoveData", "Import")" data-revert-transfer-url="@Url.Action("RevertTransfer", "Import")" data-delete-budget-initiate-url="@Url.Action("DeleteBudgetInitiate", "Import")" data-update-details-url="@Url.Action("UpdateDetails", "Import")" data-get-bank-names-url="@Url.Action("GetBankNames", "Import")" data-get-budget-data-url="@Url.Action("GetBudgetData", "Import")"></div>
    <div class="container-fluid import-initiate-page">
        <div class="main-card">
            <div class="import-toolbar">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importQueryModal">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add
                </button>
                <div class="import-filters">
                    <div class="filter-field">
                        <label for="ddlYear">Year</label>
                        <select class="form-select filter-group-inline" id="ddlYear">
                            <option value="0">--Year--</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                    <div class="filter-field">
                        <label for="ddlMonth">Month</label>
                        <select class="form-select filter-group-inline" id="ddlMonth">
                            <option value="0">--Month--</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="filter-field">
                        <label for="ddlbyBank">Bank</label>
                        <select class="form-select filter-group-inline" id="ddlbyBank">
                            <option value="">--Bank--</option>
                        </select>
                    </div>
                    <button type="button" id="btnMove" class="btn btn-success">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Move
                    </button>
                </div>
            </div>
            <div id="summaryPanel" class="alert" style="display:none; padding: 15px; margin-bottom: 20px;">
                <h4 id="summaryStatus" style="margin-top: 0; font-weight: bold;"></h4>
                <ul style="margin-bottom: 5px;">
                    <li><strong>Records Inserted Successfully:</strong> <span id="statInserted">0</span></li>
                    <li><strong>Duplicate Records Skipped:</strong> <span id="statDuplicates">0</span></li>
                </ul>
                <p id="summaryMessage" style="margin-top: 10px; font-style: italic;"></p>
            </div>
            <div class="grid-container">
                <table class="table table-striped table-bordered table-sm table-sticky" id="auditGrid" style="font-size: 11px; margin-bottom:0;">
                    <colgroup>
                        <col class="column-id" />
                        <col class="column-bank" />
                        <col class="column-period" />
                        <col class="column-type" />
                        <col class="column-transfer" />
                        <col class="column-amount" />
                        <col class="column-date" />
                        <col class="column-details" />
                        <col class="column-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>ID<input type="search" class="column-search" data-column="0" placeholder="Search"></th>
                            <th>Bank<input type="search" class="column-search" data-column="1" placeholder="Search"></th>
                            <th>Period<input type="search" class="column-search" data-column="2" placeholder="Search"></th>
                            <th>Type<input type="search" class="column-search" data-column="3" placeholder="Search"></th>
                            <th style="text-align: center;">IsTransfered?<input type="search" class="column-search" data-column="4" placeholder="Search"></th>
                            <th>Amount<input type="search" class="column-search" data-column="5" placeholder="Search"></th>
                            <th>Date<input type="search" class="column-search" data-column="6" placeholder="Search"></th>
                            <th>Details<input type="search" class="column-search" data-column="7" placeholder="Search"></th>
                            <th class="actions-heading" aria-label="Actions"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="importQueryModal" tabindex="-1" aria-labelledby="importQueryModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="importQueryModalTitle">Add Budget Import Query</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("ImportInitiate", "Import", FormMethod.Post, new { id = "sqlScriptForm" }))
                    {
                        <div class="form-group">
                            <label for="sqlScript" class="control-label">Paste SQL Insert Statement Block:</label>
                            <textarea id="sqlScript" name="sqlScript" class="form-control textarea-sql" rows="18"
                                      placeholder="INSERT INTO [dbo].[BudgetInitiate]..."></textarea>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnClear" class="btn btn-secondary">Clear</button>
                    <button type="submit" form="sqlScriptForm" class="btn btn-primary">
                        <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Execute Import
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered details-modal-dialog">
            <div class="modal-content details-modal">
                <div class="modal-header details-modal-header">
                    <div class="details-modal-heading">
                        <span class="details-modal-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
                        <div>
                            <h5 class="modal-title" id="detailsModalTitle">Update Details</h5>
                            <p class="details-modal-subtitle">Edit the transaction description</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body details-modal-body">
                    <label class="details-editor-label" for="detailsEditor">Transaction details</label>
                    <textarea id="detailsEditor" class="form-control details-editor" rows="7" placeholder="Enter transaction details..." aria-describedby="detailsEditorHint"></textarea>
                    <div id="detailsEditorHint" class="details-editor-hint">Keep the description clear and easy to recognize.</div>
                    <input type="hidden" id="detailsRecordId" />
                </div>
                <div class="modal-footer details-modal-footer">
                    <button type="button" class="btn btn-light details-cancel-button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveDetails" class="btn btn-primary details-save-button">
                        <i class="bi bi-check2" aria-hidden="true"></i> Save changes
                    </button>
                </div>
            </div>
        </div>
    </div>