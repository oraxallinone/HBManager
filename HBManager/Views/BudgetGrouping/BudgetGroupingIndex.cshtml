                                        </div>

                                    </div>
                                </div>
                                <div id="divDDLSingle">
                                    <select class="ddl-group" id="ddlUpdateG1">
                                        <option>--- G1 ---</option>
                                    </select>
                                    <select class="ddl-group" id="ddlUpdateG2">
                                        <option>--- G2 ---</option>
                                    </select>
                                    <select class="ddl-group" id="ddlUpdateG3">
                                        <option>--- G3 ---</option>
                                    </select>
                                    <select class="ddl-group" id="ddlUpdateG4">
                                        <option>--- G4 ---</option>
                                    </select>
                                </div>
                                <div id="divDDLMulti">
                                    <select id="ddlUpdateG1Group" class="search-ddl-g-all">
                                        <option value="0">-- G1 --</option>
                                    </select>
                                    <select id="ddlUpdateG2Group" class="search-ddl-g-all">
                                        <option value="0">-- G2 --</option>
                                    </select>
                                    <select id="ddlUpdateG3Group" class="search-ddl-g-all">
                                        <option value="0">-- G3 --</option>
                                    </select>
                                    <select id="ddlUpdateG4Group" class="search-ddl-g-all">
                                        <option value="0">-- G4 --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">

                                <input id="btnsingleSearch" value="Search" class="btn btn-primary1 btn-sm" type="button"  />
                                <button id="btnUpdateBudgetGroupSingle" class="btn-update-single" type="button">Update Single</button>
                                <button id="btnUpdateBudgetGroup" class="btn-update-group" type="button">Update Group</button>

                                <span id="spanTotal">0</span> || <span id="spanTotalSave">0</span> || <span id="spanTotalSpend">0</span>
                            </div>
                        </div>

                        <div class="div-responsive">
                            <table id="gridTableBudget" class="custom-tbl-common" border="1">
                                <thead>
                                    <tr>
                                        <th style="">Action</th>
                                        <th style="">Date</th>
                                        <th style="">Amt</th>
                                        <th style=""></th>
                                        <th style="">Details</th>
                                        <th style="">Bank</th>
                                        <th style="">G1</th>
                                        <th style="">G2</th>
                                        <th style="">G3</th>
                                        <th style="">G4</th>
                                    </tr>
                                </thead>
                                <tbody>
