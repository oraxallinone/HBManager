@{
    ViewBag.Title = "Update Budget Spend Date";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<style>
    .update-datetime-page {
        background: linear-gradient(135deg, #dff7f4 0%, #e6edff 48%, #f7e8ff 100%);
        min-height: calc(100vh - 3.5rem);
        padding: 0.75rem;
    }

    .update-datetime-panel {
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        background: rgba(255, 255, 255, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.78);
        border-radius: 18px;
        box-shadow: 0 18px 38px rgba(30, 64, 175, 0.1), inset 0 1px rgba(255, 255, 255, 0.8);
        margin: 0 auto;
        max-width: 1400px;
        padding: 1rem;
    }

    .update-datetime-title {
        color: #164e63;
        font-size: 1.25rem;
        font-weight: 800;
        margin: 0 0 0.75rem;
    }

    .update-datetime-filters {
        align-items: end;
        background: linear-gradient(135deg, rgba(224, 242, 254, 0.72), rgba(236, 253, 245, 0.56));
        border: 1px solid rgba(100, 149, 190, 0.3);
        border-radius: 12px;
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.7);
        padding: 0.75rem;
    }

    .update-datetime-page label {
        color: #164e63;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .update-datetime-page .form-control {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(100, 149, 190, 0.42);
        border-radius: 8px;
        font-size: 12px;
        min-height: 31px;
        padding: 0.3rem 0.55rem;
    }

    .update-datetime-page .form-control:focus {
        background: rgba(255, 255, 255, 0.94);
        border-color: #0891b2;
        box-shadow: 0 0 0 0.18rem rgba(8, 145, 178, 0.15);
    }

    .update-datetime-page .btn {
        border: 0;
        border-radius: 8px;
        box-shadow: 0 5px 12px rgba(15, 23, 42, 0.12);
        font-size: 12px;
        font-weight: 700;
        padding: 0.35rem 0.7rem;
    }

    #load-data-btn { background: linear-gradient(135deg, #0e7490, #2563eb); color: #fff; }
    #budget-table-wrapper {
        background: rgba(255, 255, 255, 0.42);
        border: 1px solid rgba(100, 149, 190, 0.28);
        border-radius: 10px;
        margin-top: 0.9rem;
        overflow: auto;
    }

    #budget-table { margin-bottom: 0; }
    #budget-table thead th {
        background: linear-gradient(135deg, #155e75, #1d4ed8);
        border-color: rgba(255, 255, 255, 0.2);
        color: #fff;
        font-size: 12px;
        padding: 0.55rem;
        white-space: nowrap;
    }

    #budget-table tbody tr { background: rgba(255, 255, 255, 0.5); }
    #budget-table tbody td {
        border-color: rgba(100, 149, 190, 0.22);
        color: #164e63;
        font-size: 12px;
        padding: 0.45rem 0.55rem;
        vertical-align: middle;
    }

    @@media (max-width: 768px) {
        .update-datetime-page { padding: 0.4rem 0.25rem; }
        .update-datetime-panel { border-radius: 14px; padding: 0.6rem; }
        .update-datetime-filters { padding: 0.55rem; }
    }
</style>

<div class="app-content update-datetime-page">
    <div class="container-fluid">
        <div class="update-datetime-panel">
            <h2 class="update-datetime-title">Update Budget Spend Date</h2>

            <div class="row g-3 update-datetime-filters">
                <div class="col-md-3">
                    <label for="month-ddl">Month:</label>
                    <select id="month-ddl" class="form-control"></select>
                </div>
                <div class="col-md-3">
                    <label for="year-ddl">Year:</label>
                    <select id="year-ddl" class="form-control"></select>
                </div>
                <div class="col-md-2">
                    <button id="load-data-btn" class="btn form-control">Load Data</button>
                </div>
            </div>

            <div id="budget-table-wrapper">
                <table id="budget-table" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Spend Date</th>
                            <th>Amount</th>
                            <th>Details</th>
                            <th>Bank</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Populate dropdowns
        const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        const currentYear = new Date().getFullYear();
        for (let i = 0; i < 12; i++) {
            $('#month-ddl').append(`<option value="${i + 1}">${months[i]}</option>`);
        }
        for (let i = currentYear - 5; i <= currentYear + 1; i++) {
            $('#year-ddl').append(`<option value="${i}">${i}</option>`);
        }
        $('#year-ddl').val(currentYear);
        $('#month-ddl').val(new Date().getMonth() + 1);

        // Load Data Button Click
        $('#load-data-btn').click(function () {
            const month = $('#month-ddl').val();
            const year = $('#year-ddl').val();

            $.ajax({
                url: '@Url.Action("GetBudgetData", "UpdateDatetime")',
                type: 'GET',
                data: { month: month, year: year },
                success: function (response) {
                    if (response.Success) {
                        const tableBody = $('#budget-table tbody');
                        tableBody.empty();
                        response.Data.forEach(function (item) {
                            let spendDate = '';
                            if (item.SpendDate) {
                                let d = new Date(parseInt(item.SpendDate.substr(6)));
                                let pad = (n) => String(n).padStart(2, '0');
                                spendDate = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
                            }

                            let row = `<tr data-id="${item.Id}">
                                        <td>${item.Id}</td>
                                        <td><input type="datetime-local" class="form-control spend-date-input" value="${spendDate}" disabled /></td>
                                        <td>${item.Amount}</td>
                                        <td>${item.Details}</td>
                                        <td>${item.BankName}</td>
                                        <td>
                                            <button class="btn btn-sm btn-info edit-btn">Edit</button>
                                            <button class="btn btn-sm btn-success save-btn" style="display:none;">Save</button>
                                        </td>
                                    </tr>`;
                            tableBody.append(row);
                        });
                    } else {
                        alert('Error loading data: ' + response.Message);
                    }
                },
                error: function () {
                    alert('An error occurred while fetching data.');
                }
            });
        });

        // Edit button click
        $('#budget-table').on('click', '.edit-btn', function () {
            var row = $(this).closest('tr');
            row.find('.spend-date-input').prop('disabled', false);
            $(this).hide();
            row.find('.save-btn').show();
        });

        // Save button click
        $('#budget-table').on('click', '.save-btn', function () {
            debugger
            var row = $(this).closest('tr');
            var id = row.data('id');
            var rawDate = row.find('.spend-date-input').val();

            if (!rawDate) {
                alert('Please select a valid date.');
                return;
            }

            // Extract YYYY-MM-DD and force time to 23:59 (11:59 PM)
            var dateOnly = rawDate.split('T')[0];
            var spendDate = rawDate;// + 'T23:59';

            $.ajax({
                url: '@Url.Action("UpdateBudgetDate", "UpdateDatetime")',
                type: 'POST',
                data: { id: id, spendDate: spendDate },
                success: function (response) {
                    if (response.Success) {
                        alert('Date updated successfully!');
                        // Update the input field value to show 11:59 PM
                        row.find('.spend-date-input').val(spendDate);
                        row.find('.spend-date-input').prop('disabled', true);
                        row.find('.save-btn').hide();
                        row.find('.edit-btn').show();
                    } else {
                        alert('Error updating date.');
                    }
                },
                error: function () {
                    alert('An error occurred while updating the date.');
                }
            });
        });
    });
</script>