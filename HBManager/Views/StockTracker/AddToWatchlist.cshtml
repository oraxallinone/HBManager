@*|| AddToWatchlist-inline1.css || react.production.min.js, react-dom.production.min.js, babel.min.js, AddToWatchlist-inline4.js ||*@
@{
    ViewBag.Title = "Stock Analysis Tracker";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Views/StockTracker/AddToWatchlist-inline1.css")" />

<div id="stockTrackerApp"
     data-list-url="@Url.Action("GetAllStocks", "StockTracker")"
     data-add-url="@Url.Action("AddStock", "StockTracker")"
     data-update-url="@Url.Action("UpdateStock", "StockTracker")"
     data-remove-url="@Url.Action("DeleteStock", "StockTracker")"></div>

<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/babel-standalone/babel.min.js"></script>

<script type="text/babel" src="@Url.Content("~/Scripts/ViewAssets/Views/StockTracker/AddToWatchlist-inline4.js")"></script>