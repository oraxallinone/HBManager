@model HBManager.Models.QueryViewModel
@{
    Layout = null;
    ViewBag.Title = "Execute Budget Query";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ExecuteQuery</title>
</head>
<body>
    <div>
        <h2>Enter Budget Details Query</h2>
        @using (Html.BeginForm("ExecuteQuery", "Import", FormMethod.Post, new { id = "queryForm" }))
        {
            @Html.AntiForgeryToken()
            <h4>SELECT [Id] ,[Year] ,[Month] ,[SpendDate] ,[Amount] ,[Details] ,[G1] ,[G2] ,[G3] ,[G4] ,[CreatedTime] ,[IsVerified] FROM [cbtsplco_annapurna].[dbo].[Budget]</h4>

            <div class="form-group" style="margin-bottom: 15px;">
                <label for="SqlQuery">Paste your INSERT query here:</label>

                @Html.TextAreaFor(m => m.SqlQuery, new
           {
               @class = "form-control",
               id = "SqlQueryTextArea",
               rows = "10",
               style = "max-width: 100%; width: 800px; font-family: monospace;"
           })

                @Html.ValidationMessageFor(m => m.SqlQuery, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary">Execute Query</button>

            <button type="button" class="btn btn-secondary" style="margin-left: 10px;" onclick="clearForm()">Clear</button>
        }
        <br />
        @if (Model != null && !string.IsNullOrEmpty(Model.Message))
        {
            <div id="messageAlert" style="padding: 15px; border-radius: 5px; font-weight: bold;
                background-color: @(Model.IsSuccess ? "#d4edda" : "#f8d7da");
                color: @(Model.IsSuccess ? "#155724" : "#721c24");
                border: 1px solid @(Model.IsSuccess ? "#c3e6cb" : "#f5c6cb");
                width: 800px; max-width: 100%;">
                @Model.Message
            </div>
        }
    </div>

    <script type="text/javascript">
        function clearForm() {
            // Clears the textarea value
            var textarea = document.getElementById("SqlQueryTextArea");
            if (textarea) {
                textarea.value = "";
            }

            // Hides the success/error message alert box if it's visible
            var msgAlert = document.getElementById("messageAlert");
            if (msgAlert) {
                msgAlert.style.display = "none";
            }
        }
    </script>
</body>
</html>