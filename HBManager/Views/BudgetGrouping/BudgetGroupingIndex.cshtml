                                    <label for="txtAmt">Amt</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="floating-label-group">
                                    <input type="text" class="form-control form-control-sm" id="txtDetails" placeholder="" />
                                    <label for="txtDetails">Details</label>
                                </div>
                            </div>
                            <div class="col-md-2" style="text-align:right">
