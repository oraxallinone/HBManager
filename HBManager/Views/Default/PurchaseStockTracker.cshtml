@{
    ViewBag.Title = "Purchase Stock Tracker";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<style>
    body {
        font-size: 12px;
    }
                                        <th class="stock-details-column">Details</th>
                                        <th data-column="1">Stock<span class="stock-sort-icon"></span></th>
                                        <th data-column="2">Exchange<span class="stock-sort-icon"></span></th>
                                        <th data-column="3">Age<span class="stock-sort-icon"></span></th>
                                        <th data-column="4">Pur. Date<span class="stock-sort-icon"></span></th>
                                        <th data-column="5">Qty<span class="stock-sort-icon"></span></th>
                                        <th data-column="6">Pur. Price<span class="stock-sort-icon"></span></th>
                                        <th data-column="7">Last Price<span class="stock-sort-icon"></span></th>
                                        <th data-column="8">Amt Chg<span class="stock-sort-icon"></span></th>
                                        <th data-column="9">% Chg<span class="stock-sort-icon"></span></th>
                                        <th data-column="10">My Chg<span class="stock-sort-icon"></span></th>
                                        <th data-column="11">TPur Amt<span class="stock-sort-icon"></span></th>
                                        <th data-column="12">Valuation<span class="stock-sort-icon"></span></th>
                                        <th data-column="13">Inc Days<span class="stock-sort-icon"></span></th>
                                        <th data-column="14">Dec Days<span class="stock-sort-icon"></span></th>
                                        <th data-column="15">Live Price<span class="stock-sort-icon"></span></th>
                                        <th data-column="16">Live Chg Amt<span class="stock-sort-icon"></span></th>
                                        <th data-column="17">Live Chg %<span class="stock-sort-icon"></span></th>
        color: #0d6efd;
        font-size: 11px;
                                        <td></td>
        line-height: 1;
        cursor: pointer;
        vertical-align: middle;
    }

        .stock-detail-btn:hover {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
        }

        .stock-details-column {
            width: 42px;
            min-width: 42px;
            text-align: center !important;
        }

    .stock-candle-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid #dfe3e8;
                                        <td><input type="text" data-column="17" placeholder="Search" /></td>
        font-size: 11px;
    }

        .stock-candle-table th,
                                        <td colspan="18" class="text-center text-muted">Loading...</td>
            border: 1px solid #dfe3e8;
            padding: 5px 6px;
            text-align: center;
            font-size: 11px;
        }

        .stock-candle-table thead th {
            background: #eef3f8;
            color: #1f2937;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .stock-candle-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }

    .stock-change-up {
        color: #1e7f3b;
        font-weight: 600;
    }

    .stock-change-down {
        color: #d9534f;
        font-weight: 600;
    }

    .stock-change-flat {
        color: #6c757d;
        font-weight: 600;
    }

    #purchaseStockTable {
        font-size: 12px;
    }

        #purchaseStockTable th,
        #purchaseStockTable td {
            padding: 8px 6px;
            vertical-align: middle;
        }

        #purchaseStockTable thead th {
            font-size: 12px;
            font-weight: 700;
            background: #f3f3f3;
            cursor: pointer;
            user-select: none;
            position: relative;
            padding-right: 18px;
        }

            #purchaseStockTable thead th:hover {
                background: #e8e8e8;
            }

        #purchaseStockTable tbody td {
            font-size: 12px;
        }

    .stock-exchange-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.4;
        vertical-align: middle;
        border: 1px solid transparent;
        text-align: center;
    }

        .stock-exchange-badge.nse {
            background: #fdecec;
            color: #d62929;
            border-color: #f7b8b8;
        }

        .stock-exchange-badge.bse {
            background: #edf5ff;
            color: #1c66d6;
            border-color: #bfd7ff;
        }

    .stock-filter-row td {
        padding: 6px !important;
        background: #f8f8f8;
    }

    .stock-filter-row input {
        width: 100%;
        height: 26px;
        font-size: 11px;
        padding: 3px 5px;
        border: 1px solid #cfcfcf;
        border-radius: 3px;
    }

    .stock-sort-icon {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 10px;
        color: #999;
        font-weight: bold;
    }

        .stock-sort-icon.asc::after {
            content: '▲';
            color: #0d6efd;
        }

        .stock-sort-icon.desc::after {
            content: '▼';
            color: #0d6efd;
        }

    .summary-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        line-height: 1.8;
    }

    /* Modal Fullscreen & Control Button Styles */
    .modal-fullscreen-custom {
        max-width: 98vw !important;
        width: 98vw !important;
        margin: 1vh auto !important;
    }

        .modal-fullscreen-custom .modal-content {
            height: 98vh;
        }

        .modal-fullscreen-custom .modal-body {
            overflow-y: auto;
            max-height: calc(98vh - 120px);
        }

        .modal-fullscreen-custom .stock-candle-container {
            max-height: calc(98vh - 160px) !important;
        }

    .modal-btn-action {
        background: transparent;
        border: none;
        font-size: 14px;
        color: #6c757d;
        cursor: pointer;
        padding: 0 6px;
        line-height: 1;
    }

        .modal-btn-action:hover {
            color: #000;
        }
    /* Main Table Hover Override */
    #purchaseStockTable.table tbody tr:hover td,
    #purchaseStockTable.table-striped tbody tr:hover > td {
        background-color: #e9f3ff !important;
        cursor: pointer;
    }

    /* Popup Candle Table Hover Override */
    .stock-candle-table tbody tr:hover td {
        background-color: #edf5ff !important;
        cursor: pointer;
    }

    /* --- Popup Modal Candle Table Hover Effect --- */
    .stock-candle-table tbody tr:hover {
        background-color: #aebbcb !important;
        transition: background-color 0.15s ease-in-out;
    }
</style>

