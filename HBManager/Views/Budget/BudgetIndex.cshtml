<div class="modal fade waste-tracker-modal" id="wasteTrackerModal" tabindex="-1" role="dialog" aria-labelledby="wasteTrackerTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="wasteTrackerTitle">Waste budget</h5>
                <button type="button" class="btn-close waste-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="wasteTrackerId" />
                <input type="hidden" id="wasteReferenceId" />
                <dl class="row mb-3">
                    <dt class="col-sm-4">Date and time</dt>
                    <dd class="col-sm-8" id="wasteBudgetDate"></dd>
                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8" id="wasteBudgetAmount"></dd>
                    <dt class="col-sm-4">Details</dt>
                    <dd class="col-sm-8" id="wasteBudgetDetails"></dd>
                </dl>
                <label for="wasteAmount">Waste amount</label>
                <input type="number" min="0" step="0.01" class="form-control" id="wasteAmount" />
                <label for="wasteReason" class="mt-2">Reason for waste</label>
                <textarea class="form-control" id="wasteReason" maxlength="500" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="btnDeleteWaste">Delete</button>
                <button type="button" class="btn btn-secondary waste-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveWaste">Insert</button>
            </div>
        </div>
    </div>
</div>

