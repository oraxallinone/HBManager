@{
    ViewBag.Title = "Purchase Stock Tracker";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<style>
    :root {
        --stock-ivory: #f5efe6;
        --stock-cream: #fffaf3;
        --stock-blush: #d9aaa2;
        --stock-sage: #91a08b;
        --stock-brass: #c8a66b;
        --stock-walnut: #8d684e;
        --stock-ink: #3e352d;
        --stock-line: rgba(141, 104, 78, .22);
        --stock-glass: rgba(255, 250, 243, .64);
    }

    body {
        font-size: 12px;
        background: linear-gradient(135deg, #eee3d5 0%, #f8f4ec 48%, #dfe8dc 100%);
        color: var(--stock-ink);
    }

    .stock-candle-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid #dfe3e8;
        font-size: 11px;
    }

        .stock-candle-table th,
        .stock-candle-table td {
            border: 1px solid #dfe3e8;
            padding: 5px 6px;
            text-align: center;
            font-size: 11px;
        }

        .stock-candle-table thead th {
            background: #eef3f8;
            color: #1f2937;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .stock-candle-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }

    .stock-change-up {
        color: #1e7f3b;
        font-weight: 600;
    }

    .stock-change-down {
        color: #d9534f;
        font-weight: 600;
    }

    .stock-change-flat {
        color: #6c757d;
        font-weight: 600;
    }

    #purchaseStockTable {
        font-size: 12px;
    }

        #purchaseStockTable th,
        #purchaseStockTable td {
            padding: 8px 6px;
            vertical-align: middle;
        }

        #purchaseStockTable thead th {
            font-size: 12px;
            font-weight: 700;
            background: #f3f3f3;
            cursor: pointer;
            user-select: none;
            position: relative;
            padding-right: 18px;
        }

            #purchaseStockTable thead th:hover {
                background: #e8e8e8;
            }

        #purchaseStockTable tbody td {
            font-size: 12px;
        }

    .stock-exchange-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.4;
        vertical-align: middle;
        border: 1px solid transparent;
        text-align: center;
    }

        .stock-exchange-badge.nse {
            background: #fdecec;
            color: #d62929;
            border-color: #f7b8b8;
        }

        .stock-exchange-badge.bse {
            background: #edf5ff;
            color: #1c66d6;
            border-color: #bfd7ff;
        }

    .stock-filter-row td {
        padding: 6px !important;
        background: #f8f8f8;
    }

    .stock-filter-row input {
        width: 100%;
        height: 26px;
        font-size: 11px;
        padding: 3px 5px;
        border: 1px solid #cfcfcf;
        border-radius: 3px;
    }

    .stock-sort-icon {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 10px;
        color: #999;
        font-weight: bold;
    }

        .stock-sort-icon.asc::after {
            content: '▲';
            color: #0d6efd;
        }

        .stock-sort-icon.desc::after {
            content: '▼';
            color: #0d6efd;
        }

    .summary-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        line-height: 1.8;
    }

    /* Modal Fullscreen & Control Button Styles */
    .modal-fullscreen-custom {
        max-width: 98vw !important;
        width: 98vw !important;
        margin: 1vh auto !important;
    }

        .modal-fullscreen-custom .modal-content {
            height: 98vh;
        }

        .modal-fullscreen-custom .modal-body {
            overflow-y: auto;
            max-height: calc(98vh - 120px);
        }

        .modal-fullscreen-custom .stock-candle-container {
            max-height: calc(98vh - 160px) !important;
        }

    .modal-btn-action {
        background: transparent;
        border: none;
        font-size: 14px;
        color: #6c757d;
        cursor: pointer;
        padding: 0 6px;
        line-height: 1;
    }

        .modal-btn-action:hover {
            color: #000;
        }
    /* Main Table Hover Override */
    #purchaseStockTable.table tbody tr:hover td,
    #purchaseStockTable.table-striped tbody tr:hover > td {
        background-color: #e9f3ff !important;
        cursor: pointer;
    }

    /* Popup Candle Table Hover Override */
    .stock-candle-table tbody tr:hover td {
        background-color: #edf5ff !important;
        cursor: pointer;
    }

    /* --- Popup Modal Candle Table Hover Effect --- */
    .stock-candle-table tbody tr:hover {
        background-color: #aebbcb !important;
        transition: background-color 0.15s ease-in-out;
    }

    .app-content {
        min-height: calc(100vh - 60px);
        padding: 22px 14px;
    }

    .stock-glass-card,
    #purchaseStockTable,
    .modal-content {
        background: var(--stock-glass);
        border: 1px solid rgba(255, 255, 255, .72) !important;
        box-shadow: 0 18px 45px rgba(95, 72, 55, .14), inset 0 1px rgba(255, 255, 255, .76);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .card.card-primary.card-outline {
        border-top: 3px solid var(--stock-blush);
        border-radius: 14px;
        overflow: hidden;
        background: transparent;
    }

    .card-header,
    .card-body {
        background: rgba(255, 250, 243, .4) !important;
    }

    .card-title,
    .modal-title {
        color: var(--stock-ink);
        font-weight: 700;
        letter-spacing: .02em;
    }

    #purchaseStockTable {
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        color: var(--stock-ink);
    }

    #purchaseStockTable th,
    #purchaseStockTable td {
        border-color: var(--stock-line);
    }

    #purchaseStockTable thead th {
        background: rgba(145, 160, 139, .28);
        color: var(--stock-ink);
    }

    #purchaseStockTable thead th:hover {
        background: rgba(217, 170, 162, .35);
    }

    #purchaseStockTable tbody tr:nth-child(even) {
        background: rgba(255, 250, 243, .33);
    }

    #purchaseStockTable.table tbody tr:hover td,
    #purchaseStockTable.table-striped tbody tr:hover > td {
        background-color: rgba(217, 170, 162, .25) !important;
    }

    .stock-details-column,
    .stock-update-column {
        width: 50px;
        min-width: 50px;
        text-align: center !important;
    }

    .stock-detail-btn,
    .stock-update-btn {
        width: 30px;
        height: 30px;
        border: 1px solid var(--stock-brass);
        border-radius: 50%;
        background: rgba(255, 250, 243, .72);
        color: var(--stock-walnut);
        line-height: 1;
        cursor: pointer;
        transition: transform .18s ease, background .18s ease, color .18s ease;
    }

    .stock-detail-btn:hover,
    .stock-update-btn:hover {
        transform: translateY(-2px);
        background: var(--stock-blush);
        color: #fff;
    }

    .stock-update-btn {
        border-color: var(--stock-sage);
        color: #65765e;
        font-size: 18px;
    }

    .stock-filter-row td {
        background: rgba(255, 250, 243, .56);
    }

    .stock-filter-row input,
    .stock-update-form input,
    .stock-update-form select {
        border: 1px solid rgba(141, 104, 78, .32);
        border-radius: 8px;
        background: rgba(255, 255, 255, .55);
        color: var(--stock-ink);
    }

    .stock-update-form {
        display: grid;
        gap: 14px;
        padding: 8px;
    }

    .stock-update-form label {
        color: var(--stock-walnut);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .stock-update-form input,
    .stock-update-form select {
        width: 100%;
        height: 36px;
        padding: 0 10px;
    }

    .stock-update-form .form-group {
        margin: 0;
    }

    .stock-update-save {
        border: 0;
        border-radius: 8px;
        padding: 8px 16px;
        background: var(--stock-sage);
        color: #fff;
    }
</style>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">Purchase Stock Tracker</h3>
                    </div>
                    <div class="card-body stock-glass-card">
                        <div class="table-responsive">
                            <table id="purchaseStockTable" class="table table-bordered table-striped table-hover table-sm">
                                <thead>
                                    <tr>
                                        <th class="stock-details-column">Details</th>
                                        <th data-column="1">Status<span class="stock-sort-icon"></span></th>
                                        <th data-column="2">Stock<span class="stock-sort-icon"></span></th>
                                        <th data-column="3">Exchange<span class="stock-sort-icon"></span></th>
                                        <th data-column="4">Age<span class="stock-sort-icon"></span></th>
                                        <th data-column="5">Pur. Date<span class="stock-sort-icon"></span></th>
                                        <th data-column="6">Qty<span class="stock-sort-icon"></span></th>
                                        <th data-column="7">Pur. Price<span class="stock-sort-icon"></span></th>
                                        <th data-column="8">Last Price<span class="stock-sort-icon"></span></th>
                                        <th data-column="9">Amt Chg<span class="stock-sort-icon"></span></th>
                                        <th data-column="10">% Chg<span class="stock-sort-icon"></span></th>
                                        <th data-column="11">My Chg<span class="stock-sort-icon"></span></th>
                                        <th data-column="12">TPur Amt<span class="stock-sort-icon"></span></th>
                                        <th data-column="13">Valuation<span class="stock-sort-icon"></span></th>
                                        <th data-column="14">Inc Days<span class="stock-sort-icon"></span></th>
                                        <th data-column="15">Dec Days<span class="stock-sort-icon"></span></th>
                                        <th class="stock-update-column">Update</th>
                                    </tr>
                                    <tr class="stock-filter-row">
                                        <td></td>
                                        <td><input type="text" data-column="1" placeholder="Search" /></td>
                                        <td><input type="text" data-column="2" placeholder="Search" /></td>
                                        <td><input type="text" data-column="3" placeholder="Search" /></td>
                                        <td><input type="text" data-column="4" placeholder="Search" /></td>
                                        <td><input type="text" data-column="5" placeholder="Search" /></td>
                                        <td><input type="text" data-column="6" placeholder="Search" /></td>
                                        <td><input type="text" data-column="7" placeholder="Search" /></td>
                                        <td><input type="text" data-column="8" placeholder="Search" /></td>
                                        <td><input type="text" data-column="9" placeholder="Search" /></td>
                                        <td><input type="text" data-column="10" placeholder="Search" /></td>
                                        <td><input type="text" data-column="11" placeholder="Search" /></td>
                                        <td><input type="text" data-column="12" placeholder="Search" /></td>
                                        <td><input type="text" data-column="13" placeholder="Search" /></td>
                                        <td><input type="text" data-column="14" placeholder="Search" /></td>
                                        <td><input type="text" data-column="15" placeholder="Search" /></td>
                                        <td></td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="18" class="text-center text-muted">Loading...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stock Update Modal Popup -->
<div class="modal fade" id="stockUpdateModal" tabindex="-1" role="dialog" aria-labelledby="stockUpdateModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stockUpdateModalTitle">Update Stock</h5>
                <button type="button" class="close btn-close modal-btn-action" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <form id="stockUpdateForm" class="stock-update-form">
                    <div class="form-group">
                        <label for="updateStockName">Stock Name</label>
                        <input id="updateStockName" type="text" readonly />
                    </div>
                    <div class="form-group">
                        <label for="updateStockExchange">Stock Exchange</label>
                        <select id="updateStockExchange">
                            <option value="NSE">NSE</option>
                            <option value="BSE">BSE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="updateStockStatus">Status</label>
                        <select id="updateStockStatus">
                            <option value="1">New</option>
                            <option value="2">Working</option>
                            <option value="3">Partial Data</option>
                            <option value="4">API Missing</option>
                            <option value="5">No Tracking</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sm" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="stock-update-save" id="saveStockUpdate">Update</button>
            </div>
        </div>
    </div>
</div>

<!-- Stock Details Modal Popup -->
<div class="modal fade" id="stockDetailModal" tabindex="-1" role="dialog" aria-labelledby="stockDetailModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" id="stockModalDialog" role="document">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title" id="stockDetailModalTitle">Stock Details</h5>
                <div class="d-flex align-items-center">
                    <button type="button" class="modal-btn-action me-2" id="btnToggleFullScreen" title="Toggle Fullscreen">
                        <span id="fullScreenIcon">&#x26F6;</span>
                    </button>
                    <button type="button" class="close btn-close modal-btn-action" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body" id="stockDetailModalBody">
                <!-- Injected dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-1.9.0.min.js"></script>
<script>
    var currentSortColumn = -1;
    var currentSortDirection = 'asc';
    var cachedStockList = [];
    var currentUpdateStock = null;

    $(document).ready(function () {
        loadPurchaseStockTracker();

        // Fullscreen toggle event for modal
        $('#btnToggleFullScreen').on('click', function () {
            var $dialog = $('#stockModalDialog');
            $dialog.toggleClass('modal-fullscreen-custom');

            var isFull = $dialog.hasClass('modal-fullscreen-custom');
            $('#fullScreenIcon').html(isFull ? '&#128471;' : '&#x26F6;');
        });

        // Reset fullscreen mode on modal close
        $('#stockDetailModal').on('hidden.bs.modal', function () {
            $('#stockModalDialog').removeClass('modal-fullscreen-custom');
            $('#fullScreenIcon').html('&#x26F6;');
        });

        $('#saveStockUpdate').on('click', function () {
            if (!currentUpdateStock || !currentUpdateStock.slno) return;

            var $button = $(this);
            $button.prop('disabled', true).text('Saving...');
            $.ajax({
                url: '/Default/UpdatePurchaseStockTracker',
                type: 'POST',
                dataType: 'json',
                data: {
                    slno: currentUpdateStock.slno,
                    nsebse: $('#updateStockExchange').val(),
                    status: $('#updateStockStatus').val()
                },
                success: function (response) {
                    if (!response || !response.success) {
                        alert(response && response.message ? response.message : 'Unable to update stock.');
                        return;
                    }

                    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('stockUpdateModal')).hide();
                    } else {
                        $('#stockUpdateModal').modal('hide');
                    }
                    loadPurchaseStockTracker();
                },
                error: function () {
                    alert('Unable to update stock.');
                },
                complete: function () {
                    $button.prop('disabled', false).text('Update');
                }
            });
        });
    });

    function loadPurchaseStockTracker() {
        $.ajax({
            url: '/Default/GetPurchaseStockTrackerData',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (!response || !response.success) {
                    $('#purchaseStockTable tbody').html('<tr><td colspan="18" class="text-center text-danger">' + (response && response.message ? response.message : 'Unable to load data.') + '</td></tr>');
                    return;
                }

                cachedStockList = response.data || [];
                if (!cachedStockList.length) {
                    $('#purchaseStockTable tbody').html('<tr><td colspan="18" class="text-center text-muted">No stock records found.</td></tr>');
                    return;
                }

                var html = '';
                $.each(cachedStockList, function (index, item) {
                    var amountBg = item.amountChange >= 0 ? 'text-success' : 'text-danger';
                    var percentBg = item.percentChange >= 0 ? 'text-success' : 'text-danger';
                    var myChangeBg = item.myChangeAmount >= 0 ? 'text-success' : 'text-danger';
                    var stockName = item.stockName || '';
                    var exchange = (item.exchange || 'NSE').toUpperCase();
                    var exchangeClass = (exchange === 'BSE' ? 'bse' : 'nse');
                    var quantity = parseFloat(item.quantity || 0);
                    var purchasePrice = parseFloat(item.purchasePrice || 0);
                    var currentPrice = parseFloat(item.currentPrice || item.lastClosePrice || 0);
                    var isApiMissing = String(item.status || '') === '4';
                    var totalPurchaseAmount = quantity * purchasePrice;
                    var stockValuation = quantity * currentPrice;

                    html += '<tr>' +
                        '<td class="stock-details-column"><button type="button" class="stock-detail-btn" data-index="' + index + '" title="View 90 Day Details" aria-label="View 90 day details">&#8594;</button></td>' +
                        '<td>' + escapeHtml(formatStatusLabel(item.status)) + '</td>' +
                        '<td>' + escapeHtml(stockName) + '</td>' +
                        '<td class="text-center"><span class="stock-exchange-badge ' + exchangeClass + '">' + exchange + '</span></td>' +
                        '<td>' + formatDaysOrPlaceholder(item.ageOfStock) + '</td>' +
                        '<td>' + (item.purchaseDate || '') + '</td>' +
                        '<td>' + formatNumber(quantity) + '</td>' +
                        '<td>' + formatCurrency(purchasePrice) + '</td>' +
                        '<td>' + (isApiMissing ? '--' : formatCurrency(item.lastClosePrice)) + '</td>' +
                        '<td class="' + amountBg + '">' + (isApiMissing ? '--' : formatCurrency(item.amountChange)) + '</td>' +
                        '<td class="' + percentBg + '">' + (isApiMissing ? '--' : formatPercent(item.percentChange)) + '</td>' +
                        '<td class="' + myChangeBg + '">' + (isApiMissing ? '--' : formatSignedCurrency(item.myChangeAmount)) + '</td>' +
                        '<td>' + (isApiMissing ? '--' : formatCurrency(totalPurchaseAmount)) + '</td>' +
                        '<td>' + (isApiMissing ? '--' : formatCurrency(stockValuation)) + '</td>' +
                        '<td>' + (isApiMissing ? '--' : (item.increaseDays || 0)) + '</td>' +
                        '<td>' + (isApiMissing ? '--' : (item.decreaseDays || 0)) + '</td>' +
                        '<td class="stock-update-column"><button type="button" class="stock-update-btn" data-index="' + index + '" title="Update stock" aria-label="Update stock">&#8942;</button></td>' +
                        '</tr>';
                });

                $('#purchaseStockTable tbody').html(html);
                bindSearchFilters();
                bindColumnSort();

                $('.stock-detail-btn').off('click').on('click', function () {
                    var idx = parseInt($(this).attr('data-index'), 10);
                    var stock = cachedStockList[idx];
                    if (stock) {
                        openStockDetailPopup(stock);
                    }
                });

                $('.stock-update-btn').off('click').on('click', function () {
                    var idx = parseInt($(this).attr('data-index'), 10);
                    var stock = cachedStockList[idx];
                    if (stock) openStockUpdatePopup(stock);
                });
            },
            error: function () {
                $('#purchaseStockTable tbody').html('<tr><td colspan="18" class="text-center text-danger">Error loading data.</td></tr>');
            }
        });
    }

    function openStockUpdatePopup(item) {
        currentUpdateStock = item;
        $('#updateStockName').val(item.stockName || '');
        $('#updateStockExchange').val((item.exchangeCode || item.exchange || 'NSE').toUpperCase());
        $('#updateStockStatus').val(String(item.status || '1'));

        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('stockUpdateModal')).show();
        } else {
            $('#stockUpdateModal').modal('show');
        }
    }

    function openStockDetailPopup(item) {
        var stockName = item.stockName || '';
        var exchange = (item.exchange || 'NSE').toUpperCase();
        var exchangeClass = (exchange === 'BSE' ? 'bse' : 'nse');
        var myChangeBg = item.myChangeAmount >= 0 ? 'text-success' : 'text-danger';
        var quantity = parseFloat(item.quantity || 0);
        var purchasePrice = parseFloat(item.purchasePrice || 0);
        var currentPrice = parseFloat(item.currentPrice || item.lastClosePrice || 0);
        var dailyChanges = item.dailyChanges || [];

        $('#stockDetailModalTitle').html(
            escapeHtml(stockName) + ' <span class="stock-exchange-badge ' + exchangeClass + '">' + exchange + '</span> - Last 90 Days History'
        );

        var modalBodyHtml = '<div class="row">' +
            '<div class="col-md-2 mb-3">' +
            '<div class="summary-card">' +
            '<h6 class="font-weight-bold text-dark border-bottom pb-2 mb-2">Position Summary</h6>' +
            '<strong>Purchase Date:</strong> ' + (item.purchaseDate || '-') + '<br>' +
            '<strong>Age:</strong> ' + (item.ageOfStock || 0) + ' days<br>' +
            '<strong>Purchase Price:</strong> ' + formatCurrency(purchasePrice) + '<br>' +
            '<strong>Quantity:</strong> ' + formatNumber(quantity) + '<br>' +
            '<strong>Current / Last Price:</strong> ' + formatCurrency(currentPrice) + '<br>' +
            '<strong>Total Purchase Amt:</strong> ' + formatCurrency(quantity * purchasePrice) + '<br>' +
            '<strong>Current Valuation:</strong> ' + formatCurrency(quantity * currentPrice) + '<br>' +
            '<strong>My Change:</strong> <span class="' + myChangeBg + '">' + formatSignedCurrency(item.myChangeAmount) + ' (' + formatSignedPercent(item.myChangePercent) + ')</span>' +
            '</div>' +
            '</div>' +
            '<div class="col-md-10 mb-3">' +
            '<div class="stock-candle-container" style="max-height: 400px; overflow-y: auto; border: 1px solid #dfe3e8;">' +
            buildDailyChangesTable(dailyChanges) +
            '</div>' +
            '</div>' +
            '</div>';

        $('#stockDetailModalBody').html(modalBodyHtml);

        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            var modalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('stockDetailModal'));
            modalInstance.show();
        } else {
            $('#stockDetailModal').modal('show');
        }
    }

    function bindSearchFilters() {
        $('.stock-filter-row input').off('keyup change').on('keyup change', function () {
            var query = $(this).val().toLowerCase();
            var columnIndex = parseInt($(this).attr('data-column'), 10);

            $('#purchaseStockTable tbody tr').each(function () {
                var $row = $(this);
                var cellText = $row.find('td').eq(columnIndex).text().toLowerCase();
                var isMatch = cellText.indexOf(query) !== -1;
                $row.toggle(isMatch || query === '');
            });
        });
    }

    function bindColumnSort() {
        $('#purchaseStockTable thead th[data-column]').off('click').on('click', function () {
            var columnIndex = parseInt($(this).attr('data-column'), 10);
            var isAscending = true;

            if (currentSortColumn === columnIndex) {
                isAscending = currentSortDirection === 'desc';
            }

            currentSortColumn = columnIndex;
            currentSortDirection = isAscending ? 'asc' : 'desc';

            sortTableByColumn(columnIndex, isAscending);

            $('#purchaseStockTable thead th .stock-sort-icon').removeClass('asc desc');
            $(this).find('.stock-sort-icon').addClass(isAscending ? 'asc' : 'desc');
        });
    }

    function sortTableByColumn(columnIndex, isAscending) {
        var $tbody = $('#purchaseStockTable tbody');
        var rows = $tbody.find('tr').toArray();

        if (rows.length <= 1) return;

        // 1. Map rows into memory first to avoid querying the DOM inside the sort loop
        var mappedRows = rows.map(function (row, idx) {
            var rawText = $(row).find('td').eq(columnIndex).text().trim();

            // Clean currency signs, commas, '%', 'days', and '+'
            var cleanedNum = rawText.replace(/[^\d.-]/g, '');
            var numVal = parseFloat(cleanedNum);

            return {
                index: idx,
                row: row,
                rawText: rawText.toLowerCase(),
                numVal: !isNaN(numVal) && cleanedNum !== '' ? numVal : null
            };
        });

        // 2. Sort purely in-memory
        mappedRows.sort(function (a, b) {
            if (a.numVal !== null && b.numVal !== null) {
                return isAscending ? a.numVal - b.numVal : b.numVal - a.numVal;
            }
            return isAscending ? a.rawText.localeCompare(b.rawText) : b.rawText.localeCompare(a.rawText);
        });

        // 3. Batch re-insert using DocumentFragment for instant rendering (single reflow)
        var fragment = document.createDocumentFragment();
        for (var i = 0; i < mappedRows.length; i++) {
            fragment.appendChild(mappedRows[i].row);
        }

        $tbody[0].appendChild(fragment);
    }

    function buildDailyChangesTable(data) {
        if (!data || !data.length) {
            return '<div class="p-3 text-center text-muted">No historical candle data available.</div>';
        }

        // Sort descending by date so the latest day appears first
        var sortedData = data.slice().sort(function (a, b) {
            return new Date(b.date) - new Date(a.date);
        });

        var html = '<table class="stock-candle-table"><thead><tr>' +
            '<th>Date</th>' +
            '<th>Open</th>' +
            '<th>High</th>' +
            '<th>Low</th>' +
            '<th>Close</th>' +
            '<th>Change %</th>' +
            '<th>Change Amt</th>' +
            '<th>Status</th>' +
            '<th>Volume</th>' +
            '</tr></thead><tbody>';

        $.each(sortedData, function (index, item) {
            var changeClass = 'stock-change-flat';
            if (item.changeAmount > 0) changeClass = 'stock-change-up';
            if (item.changeAmount < 0) changeClass = 'stock-change-down';

            html += '<tr>' +
                '<td>' + (item.date || '') + '</td>' +
                '<td>' + formatCurrency(item.open) + '</td>' +
                '<td>' + formatCurrency(item.high) + '</td>' +
                '<td>' + formatCurrency(item.low) + '</td>' +
                '<td>' + formatCurrency(item.close) + '</td>' +
                '<td class="' + (item.changePercent >= 0 ? 'stock-change-up' : 'stock-change-down') + '">' + formatPercent(item.changePercent) + '</td>' +
                '<td class="' + changeClass + '">' + formatCurrency(item.changeAmount) + '</td>' +
                '<td class="' + changeClass + '">' + (item.changeStatus || 'FLAT') + '</td>' +
                '<td>' + formatNumber(item.volume) + '</td>' +
                '</tr>';
        });

        html += '</tbody></table>';
        return html;
    }

    function formatCurrency(value) {
        var num = parseFloat(value || 0);
        return isNaN(num) ? '0.00' : num.toFixed(2);
    }

    function formatSignedCurrency(value) {
        var num = parseFloat(value || 0);
        return isNaN(num) ? '+0.00' : ((num >= 0 ? '+' : '') + num.toFixed(2));
    }

    function formatPercent(value) {
        var num = parseFloat(value || 0);
        return isNaN(num) ? '0.00%' : (num.toFixed(2) + '%');
    }

    function formatSignedPercent(value) {
        var num = parseFloat(value || 0);
        return isNaN(num) ? '+0.00%' : ((num >= 0 ? '+' : '') + num.toFixed(2) + '%');
    }

    function formatNumber(value) {
        var num = parseFloat(value || 0);
        return isNaN(num) ? '0' : num.toLocaleString('en-IN');
    }

    function formatDaysOrPlaceholder(value) {
        return String(value) === '--' ? '--' : (value || 0) + ' days';
    }

    function formatStatusLabel(value) {
        var statusLabels = {
            '1': 'New',
            '2': 'Working',
            '3': 'Partial Data',
            '4': 'API Missing',
            '5': 'No Tracking'
        };
        var normalizedStatus = String(value || '1');
        return statusLabels[normalizedStatus] || 'New';
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>