@{
    ViewBag.Title = "BudgeMobileIndex";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
<link href="~/Content/budget-mobile-index.css" rel="stylesheet" />
<div class="app-content">
    <div class="container-fluid">
        <div class="row g-2 mb-2">
            <div class="col-6">
                <select class="form-control form-control-sm" id="ddlYear">
                    <option value="0">--Year--</option>
                    <option value="2025">2025</option>
                    <option value="2026">2026</option>
                    <option value="2027">2027</option>
                </select>
            </div>
            <div class="col-6">
                <select class="form-control form-control-sm" id="ddlMonth">
                    <option value="0">--Month--</option>
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <input type="date" class="form-control form-control-sm" id="txtDate" />
            </div>
            <div class="col-6">
                <input type="number" class="form-control form-control-sm" id="txtAmt" placeholder="Amount" />
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-10">
                <input type="text" class="form-control form-control-sm" id="txtDetails" placeholder="Details" maxlength="100" />
            </div>
            <div class="col-2 d-flex align-items-center">
                <button class="btn btn-primary btn-sm w-50" id="btnSaveBudget">Save</button>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-12">
                <div class="div-responsive-mobile">
                    <table id="gridTableBudgetMobile" class="custom-tbl-mobile w-100 mobile-table">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Date</th>
                                <th>Amt</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data will be loaded here by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/budget-mobile.js"></script>

