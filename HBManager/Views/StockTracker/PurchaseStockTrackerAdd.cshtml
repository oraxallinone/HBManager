@*|| PurchaseStockTrackerAdd-inline1.css || react.production.min.js, react-dom.production.min.js, babel.min.js, PurchaseStockTrackerAdd-inline4.js ||*@
@{
    ViewBag.Title = "Stock Purchase Details";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Views/StockTracker/PurchaseStockTrackerAdd-inline1.css")" />

<div class="purchase-page">
    <div id="purchaseStockDetailsApp" class="purchase-shell"
         data-list-url="@Url.Action("GetPurchaseStockDetails", "StockTracker")"
         data-add-url="@Url.Action("AddPurchaseStockDetail", "StockTracker")"
         data-update-url="@Url.Action("UpdatePurchaseStockDetail", "StockTracker")"
         data-remove-url="@Url.Action("DeletePurchaseStockDetail", "StockTracker")"></div>
</div>

<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/babel-standalone/babel.min.js"></script>
<script type="text/babel" src="@Url.Content("~/Scripts/ViewAssets/Views/StockTracker/PurchaseStockTrackerAdd-inline4.js")"></script>
