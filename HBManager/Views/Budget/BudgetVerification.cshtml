@*|| budget-verification.css || budget-verification.js ||*@
@{
    ViewBag.Title = "BudgetVerification";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link href="~/Content/budget-verification.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">




<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <!-- cards -->
            <div class="col-md-12">
                <div class="card card-primary  mb-1">
                    <div class="card-body" style="padding: 0px;">
                        <div class="row">

                            <div class="col-md-3" >
                                <div class="summary-card" style="background-image: linear-gradient(to right top, #34785c, #46e79f, #439e74, #00ff87, #5c7168);">
                                    <div class="row g-1">
                                        <div class="col-md-6">
                                            <div class="floating-label-group">
                                                <select class="form-control form-control-sm" id="ddlYear">
                                                    <option value="0">--Year--</option>
                                                    <option value="2024">2024</option>
                                                    <option value="2025">2025</option>
                                                    <option value="2026">2026</option>
                                                    <option value="2027">2027</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="floating-label-group">
                                                <select class="form-control form-control-sm" id="ddlMonth">
                                                    <option value="0">--Month--</option>
                                                    <option value="1">January</option>
                                                    <option value="2">February</option>
                                                    <option value="3">March</option>
                                                    <option value="4">April</option>
                                                    <option value="5">May</option>
                                                    <option value="6">June</option>
                                                    <option value="7">July</option>
                                                    <option value="8">August</option>
                                                    <option value="9">September</option>
                                                    <option value="10">October</option>
                                                    <option value="11">November</option>
                                                    <option value="12">December</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-3"  >
                                <div class="summary-card summary-in" style="background-image: linear-gradient(to right top, #051937, #004d7a, #008793, #00bf72, #a8eb12);">
                                    <div class="summary-header">
                                        <span class="summary-title">M IN </span>   <span style="font-family:Cambria, Cochin, Georgia, Times, Times New Roman, serif;font-size:12px;">** Current Month Beginning Total</span>

                                        <i class="fa-solid fa-plus summary-icon"></i>
                                    </div>
                                    <div class="summary-value">
                                        <i class="fa-solid fa-indian-rupee-sign"></i>
                                        <span id="totalIn"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3" >
                                <div class="summary-card summary-out" style="height:12vh;background-image: linear-gradient(to right top, #7c0948, #960c57, #b20e65, #ce1074, #eb1282);">
                                    <div class="summary-header">
                                        <span class="summary-title">M OUT</span>   <span style="font-family:Cambria, Cochin, Georgia, Times, Times New Roman, serif;font-size:12px;">** Current Month spending total</span>

                                        <i class="fa-solid fa-minus summary-icon"></i>
                                    </div>
                                    <div class="summary-value">
                                        <i class="fa-solid fa-indian-rupee-sign"></i>
                                        <span id="totalOut"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3" >
                                <div class="summary-card summary-now" style="height:12vh;background-image: linear-gradient(to right top, #54097c, #690c97, #7f0fb2, #9611ce, #ae12eb);">
                                    <div class="summary-header">
                                        <span class="summary-title">NOW</span>   <span style="font-family:Cambria, Cochin, Georgia, Times, Times New Roman, serif;font-size:12px;">** Current Month Total remaining</span>

                                        <i class="fa-solid fa-clock summary-icon"></i>
                                    </div>
                                    <div class="summary-value">
                                        <i class="fa-solid fa-indian-rupee-sign"></i>
                                        <span id="totalNow"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- cards2 -->
            <div class="col-md-12">
                <div class="card card-primary  mb-1">
                    <div class="card-body"  style="padding: 0px;">
                        <div class="row">

                            <div class="col-md-3" >
                                <div class="summary-card bg-success-cstm" style="height:12vh">
                                    <div class="summary-header">
                                        <span class="summary-title">COMPARE</span><span id="IdDifference"></span>
                                        <i class="fa-solid summary-icon" id="idNikiti"></i>
                                    </div>
                                    <div class="summary-title" style="color:#FFD700;font-size: 16px;" id="totalCompareIn"></div>
                                    <div class="summary-title" style="color:#E6FF00;font-size: 16px;" id="totalCompare"></div>

                                </div>
                            </div>

                            <div class="col-md-3" >
                                <div class="summary-card" style="height:12vh;background-image: linear-gradient(to right top, #3a2f0b, #6b5a1e, #a38a2f, #d4b94a, #b1ae9d);">
                                    <div class="summary-header">
                                        <table width="100%">
                                            <tr>
                                                <td width="15%"> <span>(-ve): </span> </td>
                                                <td width="20%"> <span id="idSpanNVE"></span> </td>
                                                <td width="65%"> <span style="font-size:11px;"> — Sub from budget( Extra Added)</span> </td>
                                            </tr>
                                        </table>
                                        
                                    </div>
                                    <div class="summary-header">
                                        <table width="100%">
                        <div class="modal fade verification-edit-modal" id="editMinModal" tabindex="-1" role="dialog" aria-labelledby="editMinTitle" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header"><h5 class="modal-title" id="editMinTitle">Edit M IN</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                                    <div class="modal-body">
                                        <input type="hidden" id="editMinId" />
                                        <label>Date and time</label><div class="modal-date-editor" data-prefix="editMin"><input type="date" id="editMinDate" class="form-control" /><select id="editMinHour" class="form-control"></select><span>:</span><select id="editMinMinute" class="form-control"></select><select id="editMinAmPm" class="form-control"><option>am</option><option>pm</option></select></div>
                                        <label for="editMinAmount">Amount</label><input type="number" step="0.01" id="editMinAmount" class="form-control" />
                                        <label for="editMinDetails">Details</label><input type="text" id="editMinDetails" class="form-control" />
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success" id="saveMinModal">Save</button></div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade verification-edit-modal" id="editNowModal" tabindex="-1" role="dialog" aria-labelledby="editNowTitle" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header"><h5 class="modal-title" id="editNowTitle">Edit M Now</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                                    <div class="modal-body">
                                        <input type="hidden" id="editNowId" />
                                        <label>Date and time</label><div class="modal-date-editor" data-prefix="editNow"><input type="date" id="editNowDate" class="form-control" /><select id="editNowHour" class="form-control"></select><span>:</span><select id="editNowMinute" class="form-control"></select><select id="editNowAmPm" class="form-control"><option>am</option><option>pm</option></select></div>
                                        <label for="editNowAmount">Amount</label><input type="number" step="0.01" id="editNowAmount" class="form-control" />
                                        <label for="editNowDetails">Details</label><input type="text" id="editNowDetails" class="form-control" />
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success" id="saveNowModal">Save</button></div>
                                </div>
                            </div>
                        </div>

                                            <tr>
                                                <td width="15%"> <span>(+ve): </span> </td>
                                                <td width="20%"> <span id="idSpanPVE"></span> </td>
                                                <td width="65%"> <span  style="font-size:11px;"> — Add on budget( Missing Entries)</span> </td>
                                            </tr>
                                        </table>


                                        
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3" >
                                <div class="summary-card" style="height:12vh;background-image: linear-gradient(to right top, #0a1f44, #12356b, #1b4c94, #2a66bf, #3f82e0);">
                                    <div class="summary-header">
                                        <span class="summary-title">Sal. Outstanding </span> <span id="cardRem_salary" style="padding: 2px; border-radius: 6px; background-color: #00ae7c; ">00.00</span>-<span id="cardRem_speand" style="background-color: #8e0b52; padding: 2px; border-radius: 6px;">00.00</span>
                                        <i class="fa-solid fa-clock summary-icon"></i>
                                    </div>
                                    <div class="summary-value">
                                        <i class="fa-solid fa-indian-rupee-sign"></i>
                                        <span id="cardRem_remain">00.00</span>
                                    </div>
                                </div>
                            </div>

                            

                        </div>
                    </div>
                </div>
            </div>


            <!-- Details Table Row -->
            <div class="col-md-12">
                <div class="card card-success ">
                    <div class="div-responsive-dash verification-lists-container" style="padding: 5px 5px 5px 5px;">


                        <div class="row">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header card-header-in" style="background-image: linear-gradient(to right top, #10097c, #004fb7, #0085d5, #00b9de, #12ebdf);">
                                        <span class="card-title mb-1">M IN</span>    
                                        <small style="margin-left: 18%; font-size: 11px; ">** First add: Salary, monthly starting balances, and initial cash. Later add: Incoming budget items (rewards, interest, received funds)</small>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive verification-table-wrapper">
                                            <table class="table m-1" id="tblMin" style="width: 99%;">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 24%;">Date</th>
                                                        <th style="width: 13%;">Amt</th>
                                                        <th style="width: 48%;">Details</th>
                                                        <th style="width: 15%;">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td><input type="datetime-local" id="inDateAdd" class="form-control form-control-sm" /></td>
                                                        <td><input type="number" step="0.01" id="inAmountAdd" class="form-control form-control-sm" /></td>
                                                        <td><input type="text" id="inDetailsAdd" class="form-control form-control-sm" /></td>
                                                        <td><button id="addInBtn" class="btn btn-sm btn-success" style="width: 100%; ">Add</button></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header card-header-now" style="background-image: linear-gradient(to right top, #10097c, #004fb7, #0085d5, #00b9de, #12ebdf);">
                                        <h3 class="card-title mb-0">M Now</h3> 
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive verification-table-wrapper">
                                            <table class="table m-0" id="tblMnow">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 24%;">Date</th>
                                                        <th style="width: 13%;">Amt</th>
                                                        <th style="width: 48%;">Details</th>
                                                        <th style="width: 15%;">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td><input type="datetime-local" id="nowDateAdd" class="form-control form-control-sm" /></td>
                                                        <td><input type="number" step="0.01" id="nowAmountAdd" class="form-control form-control-sm" /></td>
                                                        <td><input type="text" id="nowDetailsAdd" class="form-control form-control-sm" /></td>
                                                        <td><button id="addNowBtn" class="btn btn-sm btn-success" style="width: 100%; ">Add</button></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>


        </div>
    </div>
</div>





<script src="~/Scripts/year-month-filter.js?v=20260827"></script>
<script src="~/Scripts/budget-verification.js"></script>
