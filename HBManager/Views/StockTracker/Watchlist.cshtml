@*|| Watchlist-inline1.css || react.production.min.js, react-dom.production.min.js, babel.min.js, Watchlist-inline4.js ||*@
@{
    ViewBag.Title = "Active Stock Prices";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Views/StockTracker/Watchlist-inline1.css")" />

<div id="activeStockPricesApp"
     data-prices-url="@Url.Action("GetActiveStockPrices", "StockTracker")"
     data-details-url="@Url.Action("GetStockDetails", "StockTracker")"
     data-candles-url="@Url.Action("GetStockCandles", "StockTracker")"></div>

<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/babel-standalone/babel.min.js"></script>

<script type="text/babel" src="@Url.Content("~/Scripts/ViewAssets/Views/StockTracker/Watchlist-inline4.js")"></script>
