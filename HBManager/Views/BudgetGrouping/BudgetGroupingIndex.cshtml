ss="bg-wed-day"> <input id="eee" type="checkbox" />  </td> <td class="bg-wed-day"> Ice Cream</td> <td class="bg-wed-day"> <div class="div-g1-c7">Food</div> </td> <td class="bg-wed-day"><div style="">Essential Spend.</div></td> <td class="bg-wed-day">LIC</td> <td class="bg-wed-day">Repeat</td> </tr> <tr> <td class="bg-thu-day"> <a href="#"> <i class="fa-solid fa-eye text-success"></i></a> <span class="bar-padding">|</span> <a href="#"> <i class="fa-regular fa-trash-can text-danger"></i></a> </td> <td style="background:#ffd700;">13 Nov (Thu)</td> <td class="bg-thu-day">30</td> <td class="bg-thu-day"> <input id="eee" type="checkbox" />  </td> <td class="bg-thu-day"> Ice Cream</td> <td class="bg-thu-day">Food</td> <td class="bg-thu-day"><div style="">Savings / Invest.</div></td> <td class="bg-thu-day">LIC</td> <td class="bg-thu-day">Repeat</td> </tr> <tr> <td class="bg-fri-day"> <a href="#"> <i class="fa-solid fa-eye text-success"></i></a> <span class="bar-padding">|</span> <a href="#"> <i class="fa-regular fa-trash-can text-danger"></i></a> </td> <td style="background:#add8e6;">14 Nov (Fri)</td> <td style="text-align:right;" class="bg-fri-day">560</td> <td class="bg-fri-day"> <input id="eee" type="checkbox" />  </td> <td class="bg-fri-day"> Ice Cream</td> <td class="bg-fri-day">Food</td> <td class="bg-fri-day"><div style="">Lifestyle / luxury</div></td> <td class="bg-fri-day">LIC</td> <td class="bg-fri-day">Repeat</td> </tr> <tr> <td class="bg-sat-day"> <a href="#"> <i class="fa-solid fa-eye text-success"></i></a> <span class="bar-padding">|</span> <a href="#"> <i class="fa-regular fa-trash-can text-danger"></i></a> </td> <td style="background:#000000;color:white;">15 Nov (Sat)</td> <td class="bg-sat-day">130</td> <td class="bg-sat-day"> <input id="eee" type="checkbox" /> </td> <td class="bg-sat-day"> Ice Cream</td> <td class="bg-sat-day">Food</td> <td class="bg-sat-day">Need</td> <td class="bg-sat-day">LIC</td> <td class="bg-sat-day">Repeat</td> </tr>*@
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @*<div class="card-footer" style="text-align:right;background-color: #1d68a075;">
                        
                    </div>*@
                </div>
            </div>

        </div>


    </div>
</div>

<div class="modal fade budget-date-modal" id="budgetDateModal" tabindex="-1" role="dialog" aria-labelledby="budgetDateTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="budgetDateTitle">Update date and time</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <input type="hidden" id="budgetDateId" />
                <label for="budgetDateInput">Date</label><input type="date" class="form-control" id="budgetDateInput" />
                <div class="budget-time-fields">
                    <div><label for="budgetHourInput">Hour</label><select class="form-control" id="budgetHourInput"><option>01</option><option>02</option><option>03</option><option>04</option><option>05</option><option>06</option><option>07</option><option>08</option><option>09</option><option>10</option><option>11</option><option>12</option></select></div>
                    <div><label for="budgetMinuteInput">Minute</label><select class="form-control" id="budgetMinuteInput"></select></div>
                    <div><label for="budgetAmPmInput">AM / PM</label><select class="form-control" id="budgetAmPmInput"><option>AM</option><option>PM</option></select></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="btnSaveBudgetDate">Save</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="bankNameModal" tabindex="-1" role="dialog" aria-labelledby="bankNameTitle" aria-hidden="true">
    <div class="modal-dialog" role="document"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="bankNameTitle">Bank name</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"><input type="hidden" id="bankNameBudgetId" /><label for="bankNameInput">Bank name</label><input type="text" class="form-control" id="bankNameInput" maxlength="100" /></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="btnSaveBankName">Save</button></div>
    </div></div>
</div>

