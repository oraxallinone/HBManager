@*|| GstDraftList-inline1.css, GstDraftList-inline2.css || GstDraftList-inline1.js ||*@
@model IEnumerable<HBManager.Areas.GstBill.Models.CustomerBillDTO>
@{
    ViewBag.Title = "GstDraftList";
    Layout = "~/Views/Shared/_GstLayout.cshtml";
}

<div class="content-wrapper">
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    
                    <div class="card card-info">
                        <div class="card-header">
                            <div class="col-2">
                                <h3 class="card-title">Gst Draft List</h3>
                            </div>
                            <div class="offset-10 col-2 textRight">
                                <a href="/GstBill/Invoice/GstInvoiceCreate" class="btn btn-outline-dangerCustome1 btn-dangerCustome1 btn-xs">Create New Gst Bill</a>
                            </div>
                        </div>
                        <div>
                            <div class="card-body">
                                <div class="card card-info search-report-panel">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchDraftNo" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchDraftNo">Draft No</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchInvoiceNo" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchInvoiceNo">Cancel Invoice No</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchCustomer" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchCustomer">Name</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchNote" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchNote">Note</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchDoNumber" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchDoNumber">DO Number</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchInternalNote" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchInternalNote">Internal Note</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <select id="searchGstType" class="form-control form-control-sm">
                                                        <option value="">All</option>
                                                        <option value="cgst/ sgst">CGST/ SGST</option>
                                                        <option value="igst">IGST</option>
                                                        <option value="not defined">-- Not Defined --</option>
                                                    </select>
                                                    <label for="searchGstType">Gst Type</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchDate" class="form-control form-control-sm" placeholder="dd-mm-yyyy" />
                                                    <label for="searchDate">Date</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2">
                                                <div class="floating-label-group">
                                                    <input type="text" id="searchTotalValue" class="form-control form-control-sm" placeholder=" " />
                                                    <label for="searchTotalValue">Total Value</label>
                                                </div>
                                            </div>
                                            <div class="form-group col-md-2 d-flex align-items-end search-actions">
                                                <button type="button" id="searchDrafts" class="btn btn-sm btn-info">Search</button>
                                                <button type="button" id="cancelDraftSearch" class="btn btn-sm btn-outline-danger">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>









                                <div class="row">
                                    <table width="100%" class="tableCust table-hover" style="border: 1px solid #3574a4b0; text-align: left;">
                                        <thead>
                                            <tr class="fontMenuHeader" style="text-align: left;">
                                                <td style="width:5% ;text-align: left;"> Sl No </td>
                                                <td style="width: 10%; text-align: left"> Draft No </td>
                                                <td style="width: 10%; text-align: left"> Cancel Invoice No </td>
                                                <td style="width:11% ;text-align: left;"> Name </td>
                                                <td style="width:7% ;text-align: left;"> Note </td>
                                                <td style="width:7% ;text-align: left;"> DO Number </td>
                                                <td style="width:10% ;text-align: left;"> Internal Note </td>
                                                <td style="width: 10%; text-align: left; "> Gst Type </td>
                                                <td style="width: 10%; text-align: left"> Date </td>
                                                <td style="width:10% ;text-align: left;"> Total Value </td>
                                                <td style="width:10% ;text-align: left;"> ACTION </td>
                                            </tr>
                                        </thead>
                                        <tbody id="draftTableBody">
                                            @{
                                                int snNo = Model.Count() + 1;
                                                foreach (var itm in @Model)
                                                {
                                                    snNo = snNo - 1;
                                                    string bgModified = itm.IsActive == true ? "" : "#f4240438";
                                                    string internalNote = itm.IInternalNote ?? "";
                                                    string internalNotePreview = internalNote.Length > 15 ? internalNote.Substring(0, 10) : internalNote;
                                                    <tr class="fontMenuBody draft-row" data-draft-no="@itm.IDraftNo" data-invoice-no="@itm.INo" data-customer="@itm.custName" data-note="@itm.INotes" data-do-number="@itm.IDONumber" data-internal-note="@itm.IInternalNote" data-gst-type="@(itm.gstType == 1 ? "CGST/ SGST" : itm.gstType == 2 ? "IGST" : "-- Not Defined --")" data-date="@Convert.ToDateTime(itm.IDate).ToString("dd-MM-yyyy")" data-total-value="@itm.TotalValue" style="border: 1px solid #3574a4b0;background-color:@bgModified">
                                                        <td style="text-align: left;">@snNo</td>
                                                        <td class=""> @itm.IDraftNo </td>
                                                        <td class=""> @itm.INo </td>
                                                        <td class="textLeft">@itm.custName</td>
                                                        <td class="textLeft">@itm.INotes</td>
                                                        <td class="textLeft">@itm.IDONumber</td>
                                                        <td style="text-align: left;">
                                                            @internalNotePreview
                                                            @if (internalNote.Length > 15)
                                                            {
                                                                <button type="button" class="internal-note-more" data-note="@internalNote" title="Show full internal note" aria-label="Show full internal note">
                                                                    <i class="fa fa-ellipsis-h"></i>
                                                                </button>
                                                            }
                                                        </td>

                                                        @if (itm.gstType == 1)
                                                        {
                                                            <td style="text-align: left;">CGST/ SGST</td>
                                                        }
                                                        else if (itm.gstType == 2)
                                                        {
                                                            <td style="text-align: left;">IGST</td>
                                                        }
                                                        else
                                                        {
                                                            <td style="text-align: left;">-- Not Defined --</td>
                                                        }
                                                        <td class=""> @Convert.ToDateTime(itm.IDate).ToString("dd-MM-yyyy")</td>
                                                        <td style="text-align: left;">@itm.TotalValue</td>
                                                        <td style="text-align: left;">
                                                            @Html.ActionLink("Load draft", "GstInvoiceCreate", "Invoice", new { draftNo = @itm.IDraftNo }, null)
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <div id="draftPagination" class="col-md-12 text-center"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Areas/GstBill/Views/Invoice/GstDraftList-inline1.css")" />

<link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Areas/GstBill/Views/Invoice/GstDraftList-inline2.css")" />

<script type="text/javascript" src="@Url.Content("~/Scripts/ViewAssets/Areas/GstBill/Views/Invoice/GstDraftList-inline1.js")"></script>

