@{
    ViewBag.Title = "Stock Analysis Tracker";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<style>
    .stock-page {
        min-height: 100vh;
        padding: 14px 18px;
        background: #eef2f7;
        color: #172033;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 12px;
    }

    .stock-shell {
        max-width: 1280px;
        margin: 0 auto;
    }

    .stock-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        color: #fff;
        background: linear-gradient(120deg, #102a43, #176b87);
        border-radius: 8px 8px 0 0;
    }

        .stock-hero h1 {
            margin: 0 0 3px;
            font-size: 20px;
            font-weight: 700;
        }

        .stock-hero p {
            margin: 0;
            opacity: .8;
            font-size: 11px;
        }

    .stock-count {
        min-width: 64px;
        padding: 7px 11px;
        text-align: center;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 6px;
        font-size: 10px;
    }

        .stock-count strong {
            display: block;
            font-size: 19px;
        }

    .stock-content {
        padding: 16px 20px 20px;
        background: #fff;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 8px 22px rgba(16,42,67,.12);
    }

    .stock-form {
        display: grid;
        grid-template-columns: 2fr 1.2fr 1fr auto auto;
        gap: 9px;
        align-items: end;
        padding: 12px 14px;
        margin-bottom: 14px;
        background: #f7f9fc;
        border: 1px solid #dce5ee;
        border-radius: 6px;
    }

    .field label {
        display: block;
        margin-bottom: 4px;
        color: #526579;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .field input,
    .field select {
        width: 100%;
        height: 32px;
        padding: 0 8px;
        border: 1px solid #cbd5df;
        border-radius: 4px;
        background: #fff;
        font-size: 12px;
    }

        .field input:focus,
        .field select:focus {
            outline: none;
            border-color: #168aad;
            box-shadow: 0 0 0 3px rgba(22,138,173,.12);
        }

    .btn {
        height: 32px;
        padding: 0 12px;
        border: 0;
        border-radius: 4px;
        color: #fff;
        cursor: pointer;
        font-size: 11px;
        font-weight: 600;
    }

    .btn-primary {
        background: #168aad;
    }

    .btn-secondary {
        background: #718096;
    }

    .btn-edit {
        background: #2676ca;
    }

    .btn-delete {
        background: #c44536;
    }

    .btn-save {
        background: #25855a;
    }

    .btn-cancel {
        background: #718096;
    }

    .notice {
        padding: 9px 12px;
        margin-bottom: 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .notice-success {
        color: #176b43;
        background: #e4f5ec;
        border: 1px solid #a9ddbf;
    }

    .notice-error {
        color: #9f2d25;
        background: #fde9e7;
        border: 1px solid #efb5b0;
    }

    .table-wrap {
        overflow-x: auto;
        border: 1px solid #dce5ee;
        border-radius: 6px;
    }

    .stock-table {
        width: 100%;
        min-width: 780px;
        border-collapse: collapse;
    }

        .stock-table th {
            padding: 9px 11px;
            text-align: left;
            color: #fff;
            background: #243b53;
            font-size: 10px;
            text-transform: uppercase;
        }

        .stock-table td {
            padding: 9px 11px;
            border-bottom: 1px solid #e6edf3;
            vertical-align: middle;
            font-size: 11px;
        }

        .stock-table tr:hover {
            background: #f6fafc;
        }

    .badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

    .badge-nse {
        color: #125b80;
        background: #dff3fb;
    }

    .badge-bse {
        color: #69419b;
        background: #eee4fa;
    }

    .badge-active {
        color: #176b43;
        background: #e4f5ec;
    }

    .badge-inactive {
        color: #9f2d25;
        background: #fde9e7;
    }

    .priority-high {
        color: #9f2d25;
        font-weight: 700;
    }

    .priority-medium {
        color: #a66a00;
        font-weight: 700;
    }

    .priority-low {
        color: #25855a;
        font-weight: 700;
    }

    .priority-new {
        color: #168aad;
        font-weight: 700;
    }

    .actions {
        display: flex;
        gap: 5px;
    }

        .actions .btn {
            height: 28px;
            padding: 0 9px;
            font-size: 10px;
        }

    .empty,
    .loading {
        padding: 28px;
        text-align: center;
        color: #718096;
        font-size: 11px;
    }

    .edit-input,
    .edit-select {
        width: 100%;
        height: 28px;
        padding: 0 6px;
        border: 1px solid #168aad;
        border-radius: 3px;
        font-size: 11px;
    }

    @@media (max-width: 900px) {
        .stock-form {
            grid-template-columns: 1fr 1fr;
        }

        .stock-page {
            padding: 12px;
        }
    }

    @@media (max-width: 560px) {
        .stock-form {
            grid-template-columns: 1fr;
        }

        .stock-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .stock-content {
            padding: 16px;
        }
    }
</style>

<div id="stockTrackerApp"></div>

<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/babel-standalone/babel.min.js"></script>

<script type="text/babel">
    const { useEffect, useState } = React;

    const api = {
        list: '@Url.Action("GetAllStocks", "StockTracker")',
        add: '@Url.Action("AddStock", "StockTracker")',
        update: '@Url.Action("UpdateStock", "StockTracker")',
        remove: '@Url.Action("DeleteStock", "StockTracker")'
    };

    function request(url, values) {
        return fetch(url, {
            method: values ? 'POST' : 'GET',
            headers: values
                ? { 'Content-Type': 'application/x-www-form-urlencoded' }
                : {},
            body: values ? new URLSearchParams(values) : undefined
        }).then(response => response.json());
    }

    function App() {
        const [stocks, setStocks] = useState([]);
        const [loading, setLoading] = useState(true);
        const [notice, setNotice] = useState(null);
        const [editingId, setEditingId] = useState(null);
        const [form, setForm] = useState({
            stockName: '',
            stockExchange: 'NSE',
            priority: '5'
        });
        const [editForm, setEditForm] = useState({});

        useEffect(() => {
            loadStocks();
        }, []);

        function showNotice(message, type) {
            setNotice({ message: message, type: type });
            window.setTimeout(() => setNotice(null), 3500);
        }

        function loadStocks() {
            setLoading(true);

            request(api.list)
                .then(result => {
                    if (result.success) {
                        setStocks(result.data);
                    } else {
                        showNotice(result.message, 'error');
                    }
                })
                .catch(() => showNotice('Unable to load stocks.', 'error'))
                .finally(() => setLoading(false));
        }

        function changeForm(event) {
            const name = event.target.name;
            const value = event.target.value;

            setForm(current => ({
                ...current,
                [name]: value
            }));
        }

        function changeEditForm(event) {
            const name = event.target.name;
            const value = event.target.type === 'checkbox'
                ? event.target.checked
                : event.target.value;

            setEditForm(current => ({
                ...current,
                [name]: value
            }));
        }

        function addStock(event) {
            event.preventDefault();

            if (!form.stockName.trim()) {
                showNotice('Enter a stock name.', 'error');
                return;
            }

            request(api.add, {
                stockName: form.stockName,
                stockExchange: form.stockExchange,
                priority: form.priority
            })
                .then(result => {
                    if (!result.success) {
                        showNotice(result.message, 'error');
                        return;
                    }

                    showNotice(result.message, 'success');
                    setForm({
                        stockName: '',
                        stockExchange: 'NSE',
                        priority: '5'
                    });
                    loadStocks();
                })
                .catch(() => showNotice('Unable to add stock.', 'error'));
        }

        function startEdit(stock) {
            setEditingId(stock.id);
            setEditForm({
                stockName: stock.stockName,
                stockExchange: stock.stockExchange,
                priority: String(stock.priority),
                isActive: stock.isActive
            });
        }

        function cancelEdit() {
            setEditingId(null);
            setEditForm({});
        }

        function saveEdit(id) {
            request(api.update, {
                id: id,
                stockName: editForm.stockName,
                stockExchange: editForm.stockExchange,
                priority: editForm.priority,
                isActive: editForm.isActive
            })
                .then(result => {
                    if (!result.success) {
                        showNotice(result.message, 'error');
                        return;
                    }

                    showNotice(result.message, 'success');
                    cancelEdit();
                    loadStocks();
                })
                .catch(() => showNotice('Unable to update stock.', 'error'));
        }

        function deleteStock(id) {
            if (!window.confirm('Delete this stock?')) {
                return;
            }

            request(api.remove, { id: id })
                .then(result => {
                    if (!result.success) {
                        showNotice(result.message, 'error');
                        return;
                    }

                    showNotice(result.message, 'success');
                    loadStocks();
                })
                .catch(() => showNotice('Unable to delete stock.', 'error'));
        }

        function priorityLabel(priority) {
            return priority === 5 ? 'New' : 'Priority ' + priority;
        }

        function priorityClass(priority) {
            return priority === 5
                ? 'priority-new'
                : priority === 1
                ? 'priority-high'
                : priority === 2
                    ? 'priority-medium'
                    : 'priority-low';
        }

        return (
            <div className="stock-page">
                <div className="stock-shell">
                    <header className="stock-hero">
                        <div>
                            <h1>Stock Analysis Tracker</h1>
                            <p>Manage your analysis watchlist by exchange and priority.</p>
                        </div>
                        <div className="stock-count">
                            <strong>{stocks.length}</strong>
                            Stocks
                        </div>
                    </header>

                    <main className="stock-content">
                        {notice && (
                            <div className={'notice notice-' + notice.type}>
                                {notice.message}
                            </div>
                        )}

                        <form className="stock-form" onSubmit={addStock}>
                            <div className="field">
                                <label>Stock Name</label>
                                <input
                                    name="stockName"
                                    value={form.stockName}
                                    onChange={changeForm}
                                    placeholder="Example: TCS"
                                    maxLength="100"
                                />
                            </div>

                            <div className="field">
                                <label>Exchange</label>
                                <select
                                    name="stockExchange"
                                    value={form.stockExchange}
                                    onChange={changeForm}
                                >
                                    <option value="NSE">NSE</option>
                                    <option value="BSE">BSE</option>
                                </select>
                            </div>

                            <div className="field">
                                <label>Priority</label>
                                <select
                                    name="priority"
                                    value={form.priority}
                                    onChange={changeForm}
                                >
                                     <option value="2">Priority 2</option>
                                     <option value="3">Priority 3</option>
                                     <option value="4">Priority 4</option>
                                     <option value="5">New</option>
                                     <option value="6">Priority 6</option>
                                     <option value="7">Priority 7</option>
                                     <option value="8">Priority 8</option>
                                     <option value="9">Priority 9</option>
                                     <option value="10">Priority 10</option>
                                </select>
                            </div>

                            <button className="btn btn-primary" type="submit">
                                Add Stock
                            </button>

                            <button
                                className="btn btn-secondary"
                                type="button"
                                onClick={() => setForm({
                                    stockName: '',
                                    stockExchange: 'NSE',
                                    priority: '5'
                                })}
                            >
                                Reset
                            </button>
                        </form>

                        {loading ? (
                            <div className="loading">Loading stocks...</div>
                        ) : stocks.length === 0 ? (
                            <div className="empty">No stocks have been added yet.</div>
                        ) : (
                            <div className="table-wrap">
                                <table className="stock-table">
                                    <thead>
                                        <tr>
                                            <th>Stock</th>
                                            <th>Exchange</th>
                                            <th>Priority</th>
                                            <th>Status</th>
                                            <th>Added Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {stocks.map(stock => (
                                            <tr key={stock.id}>
                                                {editingId === stock.id ? (
                                                    <React.Fragment>
                                                        <td>
                                                            <input
                                                                className="edit-input"
                                                                name="stockName"
                                                                value={editForm.stockName}
                                                                onChange={changeEditForm}
                                                            />
                                                        </td>
                                                        <td>
                                                            <select
                                                                className="edit-select"
                                                                name="stockExchange"
                                                                value={editForm.stockExchange}
                                                                onChange={changeEditForm}
                                                            >
                                                                <option value="NSE">NSE</option>
                                                                <option value="BSE">BSE</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <select
                                                                className="edit-select"
                                                                name="priority"
                                                                value={editForm.priority}
                                                                onChange={changeEditForm}
                                                            >
                                                                    <option value="1">Priority 1</option>
                                                                    <option value="2">Priority 2</option>
                                                                    <option value="3">Priority 3</option>
                                                                    <option value="4">Priority 4</option>
                                                                    <option value="5">New</option>
                                                                    <option value="6">Priority 6</option>
                                                                    <option value="7">Priority 7</option>
                                                                    <option value="8">Priority 8</option>
                                                                    <option value="9">Priority 9</option>
                                                                    <option value="10">Priority 10</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <label>
                                                                <input
                                                                    type="checkbox"
                                                                    name="isActive"
                                                                    checked={editForm.isActive}
                                                                    onChange={changeEditForm}
                                                                /> Active
                                                            </label>
                                                        </td>
                                                        <td>{stock.addedDate}</td>
                                                        <td>
                                                            <div className="actions">
                                                                <button
                                                                    className="btn btn-save"
                                                                    type="button"
                                                                    onClick={() => saveEdit(stock.id)}
                                                                >
                                                                    Save
                                                                </button>
                                                                <button
                                                                    className="btn btn-cancel"
                                                                    type="button"
                                                                    onClick={cancelEdit}
                                                                >
                                                                    Cancel
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </React.Fragment>
                                                ) : (
                                                    <React.Fragment>
                                                        <td><strong>{stock.stockName}</strong></td>
                                                        <td>
                                                            <span className={
                                                                'badge ' +
                                                                (stock.stockExchange === 'NSE'
                                                                    ? 'badge-nse'
                                                                    : 'badge-bse')
                                                            }>
                                                                {stock.stockExchange}
                                                            </span>
                                                        </td>
                                                        <td className={priorityClass(stock.priority)}>
                                                            {priorityLabel(stock.priority)}
                                                        </td>
                                                        <td>
                                                            <span className={
                                                                'badge ' +
                                                                (stock.isActive
                                                                    ? 'badge-active'
                                                                    : 'badge-inactive')
                                                            }>
                                                                {stock.isActive ? 'Active' : 'Inactive'}
                                                            </span>
                                                        </td>
                                                        <td>{stock.addedDate}</td>
                                                        <td>
                                                            <div className="actions">
                                                                <button
                                                                    className="btn btn-edit"
                                                                    type="button"
                                                                    onClick={() => startEdit(stock)}
                                                                >
                                                                    Edit
                                                                </button>
                                                                <button
                                                                    className="btn btn-delete"
                                                                    type="button"
                                                                    onClick={() => deleteStock(stock.id)}
                                                                >
                                                                    Delete
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </React.Fragment>
                                                )}
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        )}
                    </main>
                </div>
            </div>
        );
    }

    ReactDOM
        .createRoot(document.getElementById('stockTrackerApp'))
        .render(<App />);
</script>