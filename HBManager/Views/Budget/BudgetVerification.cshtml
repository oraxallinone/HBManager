@*|| budget-verification.css || budget-verification.js ||*@
@{
    ViewBag.Title = "BudgetVerification";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<link href="~/Content/budget-verification.css" rel="stylesheet" />

<div class="app-content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-1">
                                <div class="floating-label-group">
                                    <select class="form-control form-control-sm" id="ddlYear">
                                        <option value="0">--Year--</option>
                                        <option value="2024">2024</option>
                                        <option value="2025">2025</option>
                                        <option value="2026">2026</option>
                                        <option value="2027">2027</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="floating-label-group">
                                    <select class="form-control form-control-sm" id="ddlMonth">
                                        <option value="0">--Month--</option>
                                        <option value="1">January</option>
                                        <option value="2">February</option>
                                        <option value="3">March</option>
                                        <option value="4">April</option>
                                        <option value="5">May</option>
                                        <option value="6">June</option>
                                        <option value="7">July</option>
                                        <option value="8">August</option>
                                        <option value="9">September</option>
                                        <option value="10">October</option>
                                        <option value="11">November</option>
                                        <option value="12">December</option>
                                    </select>
                                </div>
                            </div>
                        </div>



                    </div>
                </div>
            </div>


            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="summary-card bg-success">
                        <div class="summary-title">M Compare</div>
                        <div class="summary-title" style="color:orange" id="totalCompareIn"></div>
                        <div class="summary-title" style="color:yellow" id="totalCompare"></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="summary-card bg-body-secondary">
                        <div class="summary-title">M IN</div>
                        <div class="summary-value" id="totalIn"></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card bg-warning">
                        <div class="summary-title">M Out</div>
                        <div class="summary-value" id="totalOut"></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card bg-info">
                        <div class="summary-title">Now</div>
                        <div class="summary-value" id="totalNow"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">M IN</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table m-0" id="tblMin">
                                <thead>
                                    <tr>
                                        <th>Amt</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer clearfix">
                        <span class="btn btn-sm btn-secondary float-end" id="footerMIN"> total MIN </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">M Out</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table m-0" id="tblMout">
                                <thead>
                                    <tr>
                                        <th>Amt</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer clearfix">
                        <span class="btn btn-sm btn-secondary float-end" id="footerOut"> total MOut </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">M Now</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table m-0" id="tblMnow">
                                <thead>
                                    <tr>
                                        <th>Amt</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer clearfix">
                        <span class="btn btn-sm btn-secondary float-end" id="footerNow"> Total MNow </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/budget-verification.js"></script>