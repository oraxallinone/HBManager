
@{
    ViewBag.Title = "ShowBirthday";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<style>
    .birthday-page {
        --birthday-text: #0f172a;
        --birthday-muted: #475569;
        --birthday-panel: rgba(255, 255, 255, 0.54);
        --birthday-cell: rgba(255, 255, 255, 0.48);
        --birthday-teal: #0d9488;
        --birthday-purple: #9333ea;
        background: linear-gradient(135deg, #506572 0%, #717992 52%, #650580 100%);
        color: var(--birthday-text);
        min-height: 0;
        padding: 1.5rem 1rem 0;
    }

    .birthday-calendar-container {
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        background: var(--birthday-panel);
        border: 1px solid rgba(255, 255, 255, 0.72);
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.09), inset 0 0 0 1px rgba(255, 255, 255, 0.45);
        margin: 0 auto;
        max-width: 90% !important;
        padding: 1.5rem;
        width: 100%;
    }

    .birthday-calendar-container .calendar-header {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .birthday-calendar-container .calendar-nav,
    .birthday-calendar-container .stats-container {
        align-items: center;
        display: flex;
        gap: 0.5rem;
    }

    .birthday-calendar-container .current-month-display {
        font-size: 1.2rem;
        font-weight: 800;
    }

    .birthday-calendar-container .btn-glass,
    .birthday-calendar-container .stat-pill {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

    .birthday-calendar-container .btn-glass {
        align-items: center;
        border-radius: 10px;
        color: var(--birthday-text);
        cursor: pointer;
        display: inline-flex;
        font-size: 0.8rem;
        font-weight: 800;
        justify-content: center;
        min-height: 34px;
        min-width: 36px;
    }

    .birthday-calendar-container .stat-pill {
        align-items: center;
        border-radius: 999px;
        display: flex;
        gap: 0.5rem;
        padding: 0.25rem 0.3rem 0.25rem 0.75rem;
    }

    .birthday-calendar-container .stat-label {
        color: var(--birthday-muted);
        font-size: 0.64rem;
        font-weight: 800;
    }

    .birthday-calendar-container .stat-badge {
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 800;
        padding: 0.15rem 0.55rem;
    }

    .birthday-calendar-container .pill-month .stat-badge {
        background: rgba(13, 148, 136, 0.15);
        border: 1px solid rgba(13, 148, 136, 0.3);
        color: var(--birthday-teal);
    }

    .birthday-calendar-container .pill-total .stat-badge {
        background: rgba(147, 51, 234, 0.14);
        border: 1px solid rgba(147, 51, 234, 0.28);
        color: var(--birthday-purple);
    }

    .birthday-calendar-container .weekdays-grid,
    .birthday-calendar-container .calendar-week-row {
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .birthday-calendar-container .weekdays-grid {
        margin-bottom: 0.5rem;
    }

    .birthday-calendar-container .weekday {
        color: var(--birthday-muted);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-align: center;
        text-transform: uppercase;
    }

    .birthday-calendar-container .calendar-rows-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .birthday-calendar-container .day-cell {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: var(--birthday-cell);
        border: 1px solid rgba(255, 255, 255, 0.62);
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-height: 80px;
        overflow: hidden;
        padding: 0.4rem 0.45rem;
    }

    .birthday-calendar-container .day-cell.empty {
        background: rgba(255, 255, 255, 0.18);
        border-style: dashed;
    }

    .birthday-calendar-container .day-cell.has-birthday {
        background: linear-gradient(135deg, rgba(204, 251, 241, 0.78), rgba(167, 243, 208, 0.48));
        border-color: rgba(13, 148, 136, 0.55);
    }

    .birthday-calendar-container .day-cell.is-today {
        border-color: #6366f1;
    }

    .birthday-calendar-container .day-number {
        align-items: center;
        border-radius: 50%;
        display: flex;
        font-size: 0.75rem;
        font-weight: 800;
        height: 20px;
        justify-content: center;
        width: 20px;
    }

    .birthday-calendar-container .is-today .day-number {
        background: #4f46e5;
        color: #fff;
    }

    .birthday-calendar-container .bday-tag {
        align-items: center;
        background: rgba(255, 255, 255, 0.84);
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-left: 3px solid var(--birthday-teal);
        border-radius: 8px;
        color: #115e59;
        display: flex;
        font-size: 9.5px;
        font-weight: 700;
        gap: 0.25rem;
        line-height: 1.15;
        min-width: 0;
        padding: 0.22rem 0.38rem;
    }

    .birthday-calendar-container .bday-tag span:last-child {
        font-size: 11px;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 768px) {
        .birthday-page { padding: 0.75rem 0.4rem; }
        .birthday-calendar-container { border-radius: 16px; padding: 0.75rem; }
        .birthday-calendar-container .calendar-header { align-items: flex-start; }
        .birthday-calendar-container .stats-container { width: 100%; }
        .birthday-calendar-container .stat-pill { flex: 1; justify-content: space-between; }
        .birthday-calendar-container .calendar-week-row,
        .birthday-calendar-container .weekdays-grid { gap: 0.25rem; }
        .birthday-calendar-container .day-cell { border-radius: 8px; min-height: 72px; padding: 0.3rem; }
        .birthday-calendar-container .bday-tag { font-size: 0.55rem; padding: 0.15rem 0.2rem; }
    }
</style>

<div class="birthday-page">
    <div id="birthdayCalendar" class="birthday-calendar-container"></div>
</div>

<script src="~/Scripts/birthday.js"></script>
<script>
        $(function () {
            // render current month calendar
            renderBirthdayCalendar('#birthdayCalendar');
        });
</script>

