@{
    ViewBag.Title = "Stock Purchase Details";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<style>
    .purchase-page {
        padding: 16px 20px;
        background: #eef2f7;
        min-height: 100vh;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 12px;
    }

    .purchase-shell {
        max-width: 1280px;
        margin: 0 auto;
    }

    .purchase-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        color: #fff;
        background: linear-gradient(120deg, #102a43, #176b87);
        border-radius: 6px 6px 0 0;
    }

    .purchase-header h1 {
        margin: 0;
        font-size: 20px;
    }

    .purchase-content {
        padding: 16px 20px 20px;
        background: #fff;
        border-radius: 0 0 6px 6px;
    }

    .purchase-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 12px;
    }

    .purchase-btn {
        border: 0;
        border-radius: 4px;
        padding: 7px 12px;
        color: #fff;
        cursor: pointer;
        font-size: 11px;
    }

    .purchase-btn-primary { background: #168aad; }
    .purchase-btn-secondary { background: #718096; }
    .purchase-btn-danger { background: #c44536; }

    .purchase-table-wrap {
        overflow-x: auto;
        border: 1px solid #dce5ee;
    }

    .purchase-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

    .purchase-table th,
    .purchase-table td {
        padding: 8px 10px;
        border: 1px solid #dce5ee;
        text-align: left;
        white-space: nowrap;
    }

    .purchase-table th {
        color: #fff;
        background: #243b53;
        cursor: pointer;
        user-select: none;
    }

    .purchase-table th span {
        float: right;
        color: #a8c1d1;
    }

    .purchase-filter-row td {
        padding: 5px;
        background: #f7f9fc;
    }

    .purchase-filter-row input {
        width: 100%;
        box-sizing: border-box;
        height: 26px;
        padding: 3px 6px;
        border: 1px solid #cbd5df;
        border-radius: 3px;
        font-size: 11px;
    }

    .purchase-actions {
        display: flex;
        gap: 5px;
    }

    .purchase-actions .purchase-btn {
        padding: 5px 9px;
        font-size: 10px;
    }

    .purchase-empty {
        padding: 24px;
        text-align: center;
        color: #718096;
    }

    .purchase-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(16, 42, 67, .55);
    }

    .purchase-modal {
        width: 100%;
        max-width: 520px;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .25);
    }

    .purchase-modal-header,
    .purchase-modal-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid #e2e8f0;
    }

    .purchase-modal-header h2 {
        margin: 0;
        font-size: 16px;
    }

    .purchase-modal-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 16px;
    }

    .purchase-field label {
        display: block;
        margin-bottom: 4px;
        color: #526579;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .purchase-field input,
    .purchase-field select {
        width: 100%;
        box-sizing: border-box;
        height: 32px;
        padding: 0 8px;
        border: 1px solid #cbd5df;
        border-radius: 4px;
        font-size: 12px;
    }

    .purchase-modal-footer {
        justify-content: flex-end;
        gap: 6px;
        border-top: 1px solid #e2e8f0;
        border-bottom: 0;
    }

    .purchase-modal-close {
        border: 0;
        background: transparent;
        color: #718096;
        font-size: 20px;
        cursor: pointer;
    }

    .purchase-delete-message {
        padding: 20px 16px;
        color: #526579;
    }

    @@media (max-width: 600px) {
        .purchase-page { padding: 10px; }
        .purchase-content { padding: 12px; }
        .purchase-modal-body { grid-template-columns: 1fr; }
    }

    /* Reference palette: warm sand, cream, walnut, charcoal, and soft white. */
    .purchase-page {
        width: 100%;
        min-height: calc(100vh - 58px);
        padding: 12px 14px 18px;
        background: linear-gradient(135deg, #f3e8d7 0%, #e6d3ba 46%, #f8f5ef 100%);
        color: #3f3025;
    }

    .purchase-shell {
        width: 100%;
        max-width: none;
        margin: 0;
    }

    .purchase-header {
        min-height: 64px;
        padding: 14px 22px;
        border-radius: 14px 14px 0 0;
        background: linear-gradient(115deg, #4d2e20, #795238 54%, #a8794d);
        box-shadow: 0 10px 24px rgba(77, 46, 32, .2), inset 0 1px rgba(255, 255, 255, .2);
    }

    .purchase-header h1 {
        color: #fffaf1;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 22px;
        letter-spacing: .02em;
    }

    .purchase-content {
        padding: 14px 16px 18px;
        border-radius: 0 0 14px 14px;
        background: rgba(255, 252, 246, .72);
        box-shadow: 0 18px 45px rgba(83, 59, 39, .15), inset 0 1px rgba(255, 255, 255, .75);
        backdrop-filter: blur(16px);
    }

    .purchase-toolbar {
        min-height: 34px;
        margin-bottom: 10px;
    }

    .purchase-btn {
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(72, 48, 32, .15);
    }

    .purchase-btn-primary { background: #a87345; }
    .purchase-btn-primary:hover { background: #875637; }
    .purchase-btn-secondary { background: #82766a; }
    .purchase-btn-danger { background: #9e4f3f; }

    .purchase-table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(151, 117, 81, .35);
        border-radius: 12px;
        background: rgba(255, 252, 246, .62);
        box-shadow: 0 12px 28px rgba(91, 65, 43, .12);
    }

    .purchase-table {
        width: 100%;
        min-width: 900px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .purchase-table th,
    .purchase-table td {
        padding: 9px 11px;
        border-color: rgba(169, 137, 102, .22);
    }

    .purchase-table th {
        position: sticky;
        top: 0;
        z-index: 2;
        color: #fffaf1;
        background: linear-gradient(110deg, #69432b, #99704b) !important;
        text-shadow: 0 1px 2px rgba(43, 27, 18, .3);
    }

    .purchase-table th span { color: #e9d8be; }

    .purchase-filter-row td {
        position: sticky;
        top: 40px;
        z-index: 1;
        padding: 6px;
        background: rgba(255, 248, 237, .96) !important;
    }

    .purchase-filter-row input {
        height: 30px;
        padding: 4px 8px;
        border: 1px solid rgba(169, 137, 102, .38);
        border-radius: 7px;
        background: rgba(255, 255, 255, .72);
        color: #463528;
    }

    .purchase-filter-row input:focus {
        border-color: #ae8056;
        outline: none;
        box-shadow: 0 0 0 3px rgba(174, 128, 86, .16);
    }

    .purchase-table tbody tr {
        background: rgba(255, 255, 255, .58);
    }

    .purchase-table tbody tr:nth-child(even) {
        background: rgba(239, 226, 207, .62);
    }

    .purchase-table tbody tr:hover {
        background: rgba(214, 191, 157, .52);
    }

    .purchase-table tbody td { color: #4a382a; }
    .purchase-empty { color: #866e58; }

    .purchase-modal-backdrop {
        background: rgba(62, 39, 26, .58);
        backdrop-filter: blur(6px);
    }

    .purchase-modal {
        max-width: 560px;
        border: 1px solid rgba(255, 255, 255, .6);
        border-radius: 14px;
        background: rgba(255, 251, 244, .92);
        box-shadow: 0 24px 65px rgba(62, 39, 26, .32);
        backdrop-filter: blur(18px);
    }

    .purchase-modal-header {
        border-bottom-color: rgba(169, 137, 102, .24);
        background: linear-gradient(110deg, #69432b, #99704b);
        color: #fffaf1;
    }

    .purchase-modal-header h2 { color: #fffaf1; }
    .purchase-modal-close { color: #f7e8d2; }

    .purchase-field label,
    .purchase-delete-message { color: #705843; }

    .purchase-field input,
    .purchase-field select {
        border-color: rgba(169, 137, 102, .38);
        border-radius: 7px;
        background: rgba(255, 255, 255, .76);
        color: #463528;
    }

    .purchase-modal-footer {
        border-top-color: rgba(169, 137, 102, .24);
    }

    /* Compact grid and encoding-safe sort indicators. */
    .purchase-header {
        min-height: 48px;
        padding: 9px 18px;
    }

    .purchase-header h1 {
        font-size: 18px;
    }

    .purchase-table th,
    .purchase-table td {
        padding: 6px 9px;
        line-height: 1.2;
    }

    .purchase-table th {
        height: 34px;
        padding-top: 7px;
        padding-bottom: 7px;
    }

    .purchase-table th span.sort-icon {
        display: inline-block;
        float: right;
        width: 14px;
        height: 14px;
        margin-left: 5px;
        color: #e9d8be;
        font-size: 0;
        line-height: 14px;
        text-align: center;
    }

    .purchase-table th span.sort-icon::before {
        font-size: 13px;
        font-weight: 700;
    }

    .purchase-table th span.sort-neutral::before { content: '\2195'; }
    .purchase-table th span.sort-ascending::before { content: '\2191'; color: #fff8e8; }
    .purchase-table th span.sort-descending::before { content: '\2193'; color: #fff8e8; }

    .purchase-filter-row td {
        padding: 4px;
    }

    .purchase-filter-row input {
        height: 26px;
        padding: 3px 7px;
    }

    .purchase-actions .purchase-btn {
        padding: 4px 8px;
    }
</style>

<div class="purchase-page">
    <div id="purchaseStockDetailsApp" class="purchase-shell"></div>
</div>

<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/babel-standalone/babel.min.js"></script>
<script type="text/babel">
    const { useEffect, useState } = React;

    const urls = {
        list: '@Url.Action("GetPurchaseStockDetails", "StockTracker")',
        add: '@Url.Action("AddPurchaseStockDetail", "StockTracker")',
        update: '@Url.Action("UpdatePurchaseStockDetail", "StockTracker")',
        remove: '@Url.Action("DeletePurchaseStockDetail", "StockTracker")'
    };

    function request(url, values) {
        return fetch(url, {
            method: values ? 'POST' : 'GET',
            headers: values ? { 'Content-Type': 'application/x-www-form-urlencoded' } : {},
            body: values ? new URLSearchParams(values) : undefined
        }).then(response => response.json());
    }

    const blankForm = {
        stockName: '',
        purchaseDate: new Date().toISOString().slice(0, 10),
        purchasePrice: '',
        purchaseQty: '',
        isSale: false,
        nsebse: 'nse'
    };

    function App() {
        const [records, setRecords] = useState([]);
        const [filters, setFilters] = useState({});
        const [sort, setSort] = useState({ column: 'slno', direction: 'desc' });
        const [modal, setModal] = useState(null);
        const [form, setForm] = useState(blankForm);
        const [pendingDelete, setPendingDelete] = useState(null);
        const [message, setMessage] = useState('');

        useEffect(() => { loadRecords(); }, []);

        function loadRecords() {
            request(urls.list).then(result => {
                if (result.success) {
                    setRecords(result.data || []);
                } else {
                    setMessage(result.message || 'Unable to load purchase records.');
                }
            }).catch(() => setMessage('Unable to load purchase records.'));
        }

        function showAdd() {
            setForm({ ...blankForm, purchaseDate: new Date().toISOString().slice(0, 10) });
            setModal('add');
        }

        function showEdit(record) {
            setForm({
                slno: record.slno,
                stockName: record.stockName,
                purchaseDate: record.purchaseDate,
                purchasePrice: record.purchasePrice,
                purchaseQty: record.purchaseQty,
                isSale: record.isSale,
                nsebse: record.nsebse || 'nse'
            });
            setModal('edit');
        }

        function updateForm(event) {
            const name = event.target.name;
            const value = event.target.type === 'checkbox' ? event.target.checked : event.target.value;
            setForm(current => ({ ...current, [name]: value }));
        }

        function saveRecord(event) {
            event.preventDefault();
            const payload = {
                stockName: form.stockName,
                purchaseDate: form.purchaseDate,
                purchasePrice: form.purchasePrice,
                purchaseQty: form.purchaseQty,
                isSale: form.isSale,
                nsebse: form.nsebse
            };
            const url = modal === 'edit' ? urls.update : urls.add;
            if (modal === 'edit') payload.slno = form.slno;

            request(url, payload).then(result => {
                if (!result.success) {
                    setMessage(result.message || 'Unable to save purchase record.');
                    return;
                }
                setModal(null);
                setMessage(result.message);
                loadRecords();
            }).catch(() => setMessage('Unable to save purchase record.'));
        }

        function askDelete(record) {
            setPendingDelete(record);
        }

        function deleteRecord() {
            if (!pendingDelete) return;
            request(urls.remove, { slno: pendingDelete.slno }).then(result => {
                setMessage(result.message || '');
                if (result.success) {
                    setPendingDelete(null);
                    loadRecords();
                }
            }).catch(() => setMessage('Unable to delete purchase record.'));
        }

        function filteredRecords() {
            return records.filter(record => Object.keys(filters).every(column => {
                const value = (record[column] == null ? '' : record[column]).toString().toLowerCase();
                return !filters[column] || value.indexOf(filters[column]) !== -1;
            })).sort((first, second) => {
                const firstValue = first[sort.column] == null ? '' : first[sort.column];
                const secondValue = second[sort.column] == null ? '' : second[sort.column];
                const result = typeof firstValue === 'number'
                    ? firstValue - Number(secondValue)
                    : firstValue.toString().localeCompare(secondValue.toString(), undefined, { sensitivity: 'base' });
                return result * sort.direction;
            });
        }

        function sortBy(column) {
            setSort(current => ({
                column: column,
                direction: current.column === column ? current.direction * -1 : 1
            }));
        }

        function sortIcon(column) {
            if (sort.column !== column) return 'neutral';
            return sort.direction === 1 ? 'ascending' : 'descending';
        }

        const visibleRecords = filteredRecords();

        return (
            <React.Fragment>
                <header className="purchase-header">
                    <h1>Stock Purchase Details</h1>
                    <button className="purchase-btn purchase-btn-primary" onClick={showAdd}>Add New</button>
                </header>
                <main className="purchase-content">
                    {message && <div className="alert alert-info">{message}</div>}
                    <div className="purchase-table-wrap">
                        <table className="purchase-table">
                            <thead>
                                <tr>
                                    {[
                                        ['slno', 'Sl No'], ['stockName', 'Stock Name'], ['purchaseDate', 'Purchase Date'],
                                        ['purchasePrice', 'Purchase Price'], ['purchaseQty', 'Purchase Qty'], ['isSale', 'Is Sale'], ['nsebse', 'NSE/BSE']
                                    ].map(column => (
                                        <th key={column[0]} onClick={() => sortBy(column[0])}>{column[1]} <span className={`sort-icon sort-${sortIcon(column[0])}`} aria-hidden="true"></span></th>
                                    ))}
                                    <th>Action</th>
                                </tr>
                                <tr className="purchase-filter-row">
                                    {['slno', 'stockName', 'purchaseDate', 'purchasePrice', 'purchaseQty', 'isSale', 'nsebse'].map(column => (
                                        <td key={column}>
                                            <input placeholder="Filter" value={filters[column] || ''} onChange={event => setFilters(current => ({ ...current, [column]: event.target.value.toLowerCase() }))} />
                                        </td>
                                    ))}
                                    <td></td>
                                </tr>
                            </thead>
                            <tbody>
                                {visibleRecords.map(record => (
                                    <tr key={record.slno}>
                                        <td>{record.slno}</td>
                                        <td>{record.stockName}</td>
                                        <td>{record.purchaseDate}</td>
                                        <td>{Number(record.purchasePrice).toFixed(4)}</td>
                                        <td>{Number(record.purchaseQty).toFixed(4)}</td>
                                        <td>{record.isSale ? 'Yes' : 'No'}</td>
                                        <td>{record.nsebse}</td>
                                        <td>
                                            <div className="purchase-actions">
                                                <button className="purchase-btn purchase-btn-primary" onClick={() => showEdit(record)}>Edit</button>
                                                <button className="purchase-btn purchase-btn-danger" onClick={() => askDelete(record)}>Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                ))}
                                {!visibleRecords.length && <tr><td colSpan="8" className="purchase-empty">No purchase records found.</td></tr>}
                            </tbody>
                        </table>
                    </div>
                </main>
                {modal && (
                    <div className="purchase-modal-backdrop">
                        <form className="purchase-modal" onSubmit={saveRecord}>
                            <div className="purchase-modal-header">
                                <h2>{modal === 'edit' ? 'Edit Purchase Details' : 'Add Purchase Details'}</h2>
                                <button type="button" className="purchase-modal-close" onClick={() => setModal(null)}>&times;</button>
                            </div>
                            <div className="purchase-modal-body">
                                <div className="purchase-field">
                                    <label>Stock Name</label>
                                    <input name="stockName" value={form.stockName} onChange={updateForm} required />
                                </div>
                                <div className="purchase-field">
                                    <label>Purchase Date</label>
                                    <input type="date" name="purchaseDate" value={form.purchaseDate} onChange={updateForm} required />
                                </div>
                                <div className="purchase-field">
                                    <label>Purchase Price</label>
                                    <input type="number" step="0.0001" min="0" name="purchasePrice" value={form.purchasePrice} onChange={updateForm} required />
                                </div>
                                <div className="purchase-field">
                                    <label>Purchase Quantity</label>
                                    <input type="number" step="0.0001" min="0" name="purchaseQty" value={form.purchaseQty} onChange={updateForm} required />
                                </div>
                                <div className="purchase-field">
                                    <label>NSE/BSE</label>
                                    <select name="nsebse" value={form.nsebse} onChange={updateForm}>
                                        <option value="nse">NSE</option>
                                        <option value="bse">BSE</option>
                                    </select>
                                </div>
                                <div className="purchase-field">
                                    <label>Sale Status</label>
                                    <label><input type="checkbox" name="isSale" checked={form.isSale} onChange={updateForm} /> Is Sale</label>
                                </div>
                            </div>
                            <div className="purchase-modal-footer">
                                <button type="button" className="purchase-btn purchase-btn-secondary" onClick={() => setModal(null)}>Cancel</button>
                                <button type="submit" className="purchase-btn purchase-btn-primary">Save</button>
                            </div>
                        </form>
                    </div>
                )}
                {pendingDelete && (
                    <div className="purchase-modal-backdrop">
                        <div className="purchase-modal" role="dialog" aria-modal="true" aria-labelledby="deletePurchaseTitle">
                            <div className="purchase-modal-header">
                                <h2 id="deletePurchaseTitle">Delete Purchase Details</h2>
                                <button type="button" className="purchase-modal-close" onClick={() => setPendingDelete(null)}>&times;</button>
                            </div>
                            <div className="purchase-delete-message">
                                Delete the purchase record for <strong>{pendingDelete.stockName}</strong> dated <strong>{pendingDelete.purchaseDate}</strong>?
                            </div>
                            <div className="purchase-modal-footer">
                                <button type="button" className="purchase-btn purchase-btn-secondary" onClick={() => setPendingDelete(null)}>Cancel</button>
                                <button type="button" className="purchase-btn purchase-btn-danger" onClick={deleteRecord}>Delete</button>
                            </div>
                        </div>
                    </div>
                )}
            </React.Fragment>
        );
    }

    ReactDOM.createRoot(document.getElementById('purchaseStockDetailsApp')).render(<App />);
</script>
