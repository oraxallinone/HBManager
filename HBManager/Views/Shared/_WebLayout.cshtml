@*|| fontsource.css, overlayscrollbars.min.css, bootstrap-icons.min.css, adminlte.css, fontawesome.css, spinner.css, _WebLayout-inline1.css || fontawesome.js, jquery-3.6.0.min.js, _WebLayout-inline3.js, jquery.dataTables.min.js, _WebLayout-inline5.js, overlayscrollbars.browser.es6.min.js, popper.min.js, bootstrap.min.js, adminlte.js, SidebarWrapper.js, _WebLayout-inline11.js ||*@
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@Page.Title</title>
    @RenderSection("head", required: false)
    <link rel="icon" type="image/png" sizes="32x32" href='@Url.Content("~/Content/img/financep1.png")' />
    <link rel="shortcut icon" href='@Url.Content("~/Content/img/financep1.png")' />

    <link href="~/Content/theme/css/fontsource.css" rel="stylesheet" />
    <link href="~/Content/theme/css/overlayscrollbars.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha256-9kPW/n5nn53j4WMRYAxe9c1rCY96Oogo/MKSVdKzPmI=" crossorigin="anonymous" />
    <link href="~/Content/theme/css/adminlte.css" rel="stylesheet" />

    <link href="~/Content/theme/fontswesome/fontawesome.css" rel="stylesheet" />
    <script src="~/Content/theme/fontswesome/fontawesome.js"></script>
    <link href="~/Content/spinner.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="@Url.Content("~/Scripts/ViewAssets/Views/Shared/_WebLayout-inline3.js")"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <link rel="stylesheet" href="@Url.Content("~/Content/ViewAssets/Views/Shared/_WebLayout-inline1.css")" />

    <script type="text/javascript" src="@Url.Content("~/Scripts/ViewAssets/Views/Shared/_WebLayout-inline5.js")"></script>
</head>
<body class="layout-fixed sidebar-expand-lg sidebar-mini sidebar-collapse bg-body-tertiary">
    @Html.AntiForgeryToken()
    @{
        var curController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
        var curAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";

        // Dashboard tree check
        var dashIs = (curController == "Default" && (curAction == "Dashboard")) ||
                     curController == "Budget" ||
                     curController == "BudgetGrouping" ||
                     curController == "Import";
        var dashOpen = dashIs ? "menu-open" : "";
        var dashActive = dashIs ? "active" : "";
        var dashDashboardActive = (curController == "Default" && curAction == "Dashboard") ? "active" : "";
        var dashBudgetVerificationActive = (curController == "Budget" && curAction == "BudgetVerification") ? "active" : "";
        //var dashBudgetMobileActive = (curController == "Budget" && curAction == "BudgetMobileIndex") ? "active" : "";
        var dashBudgetGroupingActive = (curController == "BudgetGrouping" && curAction == "BudgetGroupingIndex") ? "active" : "";
        var dashBudgetIndexActive = (curController == "Budget" && curAction == "BudgetIndex") ? "active" : "";
        var dashImportByQueryActive = (curController == "Import" && curAction == "ImportInitiate") ? "active" : "";
        var dashRepeatStatusActive = (curController == "RepeatStatus" && curAction == "RepeatStatus") ? "active" : "";

        // Feature tree check
        var featureIs = (curController == "Default" && curAction == "BarChart") ||
                        curController == "Calendar" ||
                        curController == "BudgetOverview" ||
                        curController == "Upload" ||
                        curController == "Birthday" ||
                        curController == "Notes";
        var featureOpen = featureIs ? "menu-open" : "";
        var featureActive = featureIs ? "active" : "";
        var featureBarChartActive = (curController == "Default" && curAction == "BarChart") ? "active" : "";
        var featureStockCandleActive = (curController == "StockMarket" && curAction == "StockCandle") ? "active" : "";
        var featureStockTechDataActive = (curController == "StockMarket" && curAction == "StockTechData") ? "active" : "";
        var featurePurchaseStockActive = (curController == "StockMarket" && curAction == "PurchaseStockTracker") ? "active" : "";
        var featureCalendarActive = (curController == "Calendar" && curAction == "Index") ? "active" : "";
        var featureGroupBudgetActive = (curController == "BudgetOverview" && curAction == "GroupBudgetOverview") ? "active" : "";
        var featureUploadFilesActive = (curController == "Upload" && curAction == "Index") ? "active" : "";
        var featureBirthdayAddActive = (curController == "Birthday" && curAction == "BirthdayIndex") ? "active" : "";
        var featureBirthdayShowActive = (curController == "Birthday" && curAction == "ShowBirthday") ? "active" : "";
        var featureNotesActive = (curController == "Notes" && curAction == "NoteIndex") ? "active" : "";

        // Investment tree check
        var investmentIs = (curController == "StockMarket" &&
                   (curAction == "StockCandle" || curAction == "StockTechData" || curAction == "PurchaseStockTracker")) ||
                           (curController == "StockTracker" &&
                           (curAction == "AddToWatchlist" || curAction == "Watchlist" || curAction == "PurchaseStockTrackerAdd"));
        var investmentOpen = investmentIs ? "menu-open" : "";
        var investmentActive = investmentIs ? "active" : "";
        var investmentStockCandleActive = (curController == "StockMarket" && curAction == "StockCandle") ? "active" : "";
        var investmentStockTechDataActive = (curController == "StockMarket" && curAction == "StockTechData") ? "active" : "";
        var investmentPurchaseStockActive = (curController == "StockMarket" && curAction == "PurchaseStockTracker") ? "active" : "";
        var investmentAddedStocksActive = (curController == "StockTracker" && curAction == "AddToWatchlist") ? "active" : "";
        var investmentStockPricesActive = (curController == "StockTracker" && curAction == "Watchlist") ? "active" : "";
        var investmentPurchaseDetailsActive = (curController == "StockTracker" && curAction == "PurchaseStockTrackerAdd") ? "active" : "";

        // Master tree check
        var masterIs = (curController == "Salary" || curController == "Group" || curController == "UpdateDatetime");
        var masterOpen = masterIs ? "menu-open" : "";
        var masterActive = masterIs ? "active" : "";
        var masterSalaryActive = (curController == "Salary" && curAction == "SalaryIndex") ? "active" : "";
        var masterGroupActive = (curController == "Group" && curAction == "GroupIndex") ? "active" : "";
        var masterUpdateDatetimeActive = (curController == "UpdateDatetime" && curAction == "Index") ? "active" : "";
    }

    <div class="app-wrapper">

        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (curController != "RepeatStatus")
                    {
                    <li style="margin-top: 9px;">
                        <input type="checkbox" id="checkForAll" style="vertical-align:middle; margin-right:4px;" />
                        <label for="checkForAll" style="margin-right:10px; font-weight:normal; vertical-align:middle;">All</label>
                        @if (curController == "BudgetGrouping" && curAction == "BudgetGroupingIndex")
                        {
                            <button type="button" id="budgetGroupingHelpIcon" class="btn btn-link p-0" title="Open grouping help" aria-label="Open grouping help" style="vertical-align:middle; margin-right:10px;">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                            </button>
                        }
                        <select id="searchDDlG1" class="ddl-master">
                            <option value="0">-- G1 --</option>
                        </select>
                        &nbsp;&nbsp;
                        <select id="searchDDlG2" class="ddl-master">
                            <option value="0">-- G2 --</option>
                        </select>
                        &nbsp;&nbsp;
                        <select id="searchDDlG3" class="ddl-master">
                            <option value="0">-- G3 --</option>
                        </select>
                        &nbsp;&nbsp;
                        <select id="searchDDlG4" class="ddl-master">
                            <option value="0">-- G4 --</option>
                        </select>
                    </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i id="lnkMaximize" data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i id="lnkMinimize" data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>

                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img style="background-color: rgba(23, 87, 135, 0.42);" src="~/Content/theme/img/budget.png" class="user-image rounded-circle shadow" alt="User Image" />
                            <span class="d-none d-md-inline">User</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            <li class="user-header text-bg-primary">
                                <img src="~/Content/theme/assets/img/user2-160x160.jpg" class="rounded-circle shadow" alt="User Image" />
                            </li>

                            <li class="user-footer">
                                <input id="btnLogout" type="button" class="btn btn-default btn-flat float-end" value="Sign out"
                                       data-logout-url="@Url.Action("Logout", "Login")"
                                       data-login-url="@Url.Action("LoginIndex", "Login")" />
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark" style="font-size:13px;">
            <div class="sidebar-brand">
                <a href="../index.html" class="brand-link">
                    <img src="~/Content/theme/assets/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image opacity-75 shadow" />
                    <span class="brand-text fw-light" style="color: yellow;">Finance</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        role="menu"
                        data-accordion="false">

                        <!-- Dashboard Menu -->
                        <li class="nav-item @dashOpen">
                            <a href="#" class="nav-link @dashActive">
                                <i class="nav-icon bi bi-speedometer"></i>
                                <p style="color: #f1c454; font-family: Calibri, 'Candara', 'Segoe UI', Optima, Arial, sans-serif; font-size: 15px !important; font-weight: 600; "> Dashboard <i class="nav-arrow bi bi-chevron-right"></i> </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item"> <a href="@Url.Action("BudgetVerification", "Budget")" class="nav-link @dashBudgetVerificationActive"> <i class="nav-icon bi bi-shield-check"></i> <p>Budget Verification</p> </a> </li>
                                @*<li class="nav-item"> <a href="@Url.Action("BudgetMobileIndex", "Budget")" class="nav-link @dashBudgetMobileActive"> <i class="nav-icon bi bi-phone"></i> <p>Budget Mobile</p> </a> </li>*@
                                <li class="nav-item"> <a href="@Url.Action("Dashboard", "Default")" class="nav-link @dashDashboardActive"> <i class="nav-icon bi bi-house-door"></i> <p>Dashboard</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("BudgetGroupingIndex", "BudgetGrouping")" class="nav-link @dashBudgetGroupingActive"> <i class="nav-icon bi bi-diagram-3"></i> <p>Grouping</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("BudgetIndex", "Budget")" class="nav-link @dashBudgetIndexActive"> <i class="nav-icon bi bi-cash-coin"></i> <p>Final</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("RepeatStatus", "RepeatStatus")" class="nav-link @dashRepeatStatusActive"> <i class="nav-icon bi bi-arrow-repeat"></i> <p>Repeat Status</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("ImportInitiate", "Import")" class="nav-link @dashImportByQueryActive"> <i class="nav-icon bi bi-database-fill-down"></i> <p>Import By Query</p> </a> </li>
                            </ul>
                        </li>

                        <!-- Feature Menu -->
                        <li class="nav-item @featureOpen">
                            <a href="#" class="nav-link @featureActive">
                                <i class="nav-icon bi bi-stars"></i>
                                <p style="color: #95f14d; font-family: Calibri, 'Candara', 'Segoe UI', Optima, Arial, sans-serif; font-size: 15px !important; font-weight: 600; "> Feature <i class="nav-arrow bi bi-chevron-right"></i> </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item"> <a href="@Url.Action("BarChart", "Default")" class="nav-link @featureBarChartActive"> <i class="nav-icon bi bi-bar-chart-line"></i> <p>Bar Graph</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("Index", "Calendar")" class="nav-link @featureCalendarActive"> <i class="nav-icon bi bi-calendar3"></i> <p>Calendar</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("GroupBudgetOverview", "BudgetOverview")" class="nav-link @featureGroupBudgetActive"> <i class="nav-icon bi bi-people"></i> <p>Group Sum</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("Index", "Upload")" class="nav-link @featureUploadFilesActive"> <i class="nav-icon bi bi-upload"></i> <p>File Upload</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("BirthdayIndex", "Birthday")" class="nav-link @featureBirthdayAddActive"> <i class="nav-icon bi bi-gift"></i> <p>Birthday Add</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("ShowBirthday", "Birthday")" class="nav-link @featureBirthdayShowActive"> <i class="nav-icon bi bi-calendar-event"></i> <p>Birthday Show</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("NoteIndex", "Notes")" class="nav-link @featureNotesActive"> <i class="nav-icon bi bi-journal-text"></i> <p>Notes</p> </a> </li>
                            </ul>
                        </li>

                        <!-- Investment Menu -->
                        <li class="nav-item @investmentOpen">
                            <a href="#" class="nav-link @investmentActive">
                                <i class="nav-icon bi bi-graph-up-arrow"></i>
                                <p style="color: #ff7878; font-family: Calibri, 'Candara', 'Segoe UI', Optima, Arial, sans-serif; font-size: 15px !important; font-weight: 600; "> Investment <i class="nav-arrow bi bi-chevron-right"></i> </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item"> <a href="@Url.Action("StockCandle", "StockMarket")" class="nav-link @investmentStockCandleActive"> <i class="nav-icon bi bi-graph-up-arrow"></i> <p>NSE Stock</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("StockTechData", "StockMarket")" class="nav-link @investmentStockTechDataActive"> <i class="nav-icon bi bi-cpu"></i> <p>Stock Tech Data</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("PurchaseStockTracker", "StockMarket")" class="nav-link @investmentPurchaseStockActive"> <i class="nav-icon bi bi-cart-check"></i> <p>Purchase Stock Tracker</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("AddToWatchlist", "StockTracker")" class="nav-link @investmentAddedStocksActive"> <i class="nav-icon bi bi-plus-circle"></i> <p>Add To Watchlist</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("Watchlist", "StockTracker")" class="nav-link @investmentStockPricesActive"> <i class="nav-icon bi bi-currency-rupee"></i> <p>Watchlist</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("PurchaseStockTrackerAdd", "StockTracker")" class="nav-link @investmentPurchaseDetailsActive"> <i class="nav-icon bi bi-receipt"></i> <p>Stock Purchase Details</p> </a> </li>
                            </ul>
                        </li>

                        <!-- Master Menu -->
                        <li class="nav-item @masterOpen">
                            <a href="#" class="nav-link @masterActive">
                                <i class="nav-icon bi bi-box-seam-fill"></i>
                                <p style="color: #89ffff; font-family: Calibri, 'Candara', 'Segoe UI', Optima, Arial, sans-serif; font-size: 15px !important; font-weight: 600; "> Master <i class="nav-arrow bi bi-chevron-right"></i> </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item"> <a href="@Url.Action("SalaryIndex", "Salary")" class="nav-link @masterSalaryActive"> <i class="nav-icon bi bi-currency-dollar"></i> <p>Salary</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("GroupIndex", "Group")" class="nav-link @masterGroupActive"> <i class="nav-icon bi bi-people-fill"></i> <p>Group</p> </a> </li>
                                <li class="nav-item"> <a href="@Url.Action("Index", "UpdateDatetime")" class="nav-link @masterUpdateDatetimeActive"> <i class="nav-icon bi bi-clock-history"></i> <p>Update Datetime</p> </a> </li>
                            </ul>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <main class="app-main">
            <div class="app-content-header"> </div>
            <div id="loadingSpinner" style="display:none;">
                <div class="spinner-overlay">
                    <div class="loader"></div>
                </div>
            </div>

            @RenderBody()
        </main>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/browser/overlayscrollbars.browser.es6.min.js" integrity="sha256-dghWARbRe2eLlIJ56wNB+b760ywulqK3DzZYEpsg2fQ=" crossorigin="anonymous"></script>
    <script src="~/Content/theme/js/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    <script src="~/Content/theme/js/adminlte.js"></script>
    <script src="~/Content/theme/js/SidebarWrapper.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/ViewAssets/Views/Shared/_WebLayout-inline11.js")"></script>
</body>
</html>